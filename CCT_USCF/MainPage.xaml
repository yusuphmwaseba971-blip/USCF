<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.MainPage"
    BackgroundColor="White">

    <Grid>

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="20">

            <Image
                Source="icon.jpeg"
                WidthRequest="180"
                HeightRequest="180"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                Text="CCT by USCF"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="Black" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>