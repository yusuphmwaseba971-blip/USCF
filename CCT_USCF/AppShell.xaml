<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="CCT_USCF.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CCT_USCF.Pages"
    Title="USCF"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource BrandGreen}, Dark={StaticResource UscfBackgroundDark}}"
    Shell.ForegroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource White}"
    TabBarBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource UscfBackgroundDark}}"
    TabBarForegroundColor="{StaticResource BrandGreen}"
    TabBarTitleColor="{StaticResource BrandGreen}"
    TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">

    <TabBar>
        <ShellContent Title="Home" Icon="home_tab.svg" Route="home" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Bible" Icon="bible_tab.svg" Route="bible" ContentTemplate="{DataTemplate pages:BiblePage}" />
        <ShellContent Title="Prayer" Icon="prayer_tab.svg" Route="prayer" ContentTemplate="{DataTemplate pages:PrayerPage}" />
        <ShellContent Title="Community" Icon="community_tab.svg" Route="community" ContentTemplate="{DataTemplate pages:CommunityPage}" />
        <ShellContent Title="Profile" Icon="profile_tab.svg" Route="profile" ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>

    <Shell.TitleView>
        <Grid Padding="8,0,8,0" ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" x:Name="AssistantButton"
                    Text="✦" FontSize="20"
                    SemanticProperties.Description="Open USCF Assistance"
                    BackgroundColor="{StaticResource SoftMint}"
                    TextColor="{StaticResource BrandDeepGreen}"
                    CornerRadius="22" WidthRequest="44" HeightRequest="44"
                    Padding="0" Clicked="OnAssistantClicked" />
            <Button x:Name="SignUpLoginButton"
                    Grid.Column="2"
                    Text="Sign Up / Login"
                    SemanticProperties.Hint="Open authentication actions"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Clicked="OnSignUpLoginClicked"
                    IsVisible="False" />

            <Button x:Name="AuthProfileButton"
                    Grid.Column="2"
                    Text="Profile"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Clicked="OnAuthProfileClicked"
                    IsVisible="False" />
        </Grid>
    </Shell.TitleView>

</Shell>