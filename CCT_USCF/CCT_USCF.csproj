<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>CCT_USCF</RootNamespace>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

		<AndroidSdkDirectory>C:\Users\Yusuph\AppData\Local\Android\Sdk</AndroidSdkDirectory>
		<JavaSdkDirectory>C:\Program Files\Microsoft\jdk-21.0.12.8-hotspot</JavaSdkDirectory>

		<!-- XAML source generation -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Application information -->
		<ApplicationTitle>USCF</ApplicationTitle>
		<ApplicationId>com.uscf.cct</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android minimum version -->
		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>

		<!-- Disable Windows packaging -->
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)' == 'Debug|net10.0-android'">
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>

		<!-- Application Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg"
		          ForegroundFile="Resources\AppIcon\appiconfg.svg"
		          Color="#009E2C" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg"
		                  Color="#009E2C"
		                  BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**"
		           LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

	</ItemGroup>

	<ItemGroup>

		<!-- .NET MAUI -->
		<PackageReference Include="Microsoft.Maui.Controls"
		                  Version="$(MauiVersion)" />

		<!-- Logging -->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug"
		                  Version="10.0.0" />

		<!-- Firebase -->
		<PackageReference Include="Plugin.Firebase"
		                  Version="4.2.1" />

	</ItemGroup>

	<!-- Firebase Android configuration -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<GoogleServicesJson Include="google-services.json" />
	</ItemGroup>

	<!-- Keep existing backend files outside the MAUI project -->
	<ItemGroup>
		<Compile Remove="USCF.Backend\**\*.cs" />
		<EmbeddedResource Remove="USCF.Backend\**\*" />
		<MauiAsset Remove="USCF.Backend\**\*" />
		<None Remove="USCF.Backend\**\*" />
	</ItemGroup>

</Project>
