
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target Android only -->
    <TargetFramework>net10.0-android</TargetFramework>

    <OutputType>Exe</OutputType>
    <RootNamespace>CCT_USCF</RootNamespace>

    <!-- .NET MAUI -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- C# -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Android -->
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>

    <!-- Build -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- XAML source generation -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Application -->
    <ApplicationTitle>USCF</ApplicationTitle>
    <ApplicationId>com.uscf.cct</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Disable Windows packaging -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Local Android SDK -->
    <AndroidSdkDirectory>
      C:\Users\Yusuph\AppData\Local\Android\Sdk
    </AndroidSdkDirectory>

    <!-- Java 21 -->
    <JavaSdkDirectory>
      C:\Program Files\Microsoft\jdk-21.0.12.8-hotspot
    </JavaSdkDirectory>
  </PropertyGroup>


  <!-- =========================================================
       DEBUG ANDROID
       ========================================================= -->

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)' == 'Debug|net10.0-android'">
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
  </PropertyGroup>


  <!-- =========================================================
       MAUI RESOURCES
       ========================================================= -->

  <ItemGroup>

    <!-- Application Icon -->
    <MauiIcon Include="Resources\AppIcon\uscf_logo.png" Link="uscf_app_icon.png" LogicalName="uscf_app_icon.png" BaseSize="128,128" Color="#FFFFFF" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\uscf_logo.png" Link="uscf_splash_screen.png" LogicalName="uscf_splash_screen.png" BaseSize="128,128" Color="#FFFFFF" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

  </ItemGroup>


  <!-- =========================================================
       NUGET PACKAGES
       ========================================================= -->

  <ItemGroup>

    <!-- .NET MAUI -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <!-- Appwrite
         Used for:
         - Images
         - Videos
         - Audio
         - Documents
    -->
    <PackageReference Include="Appwrite" Version="7.0.0" />

    <!-- Firebase
         Used for:
         - Authentication
         - Firestore
         - Cloud Messaging
         - Firebase services
    -->
    <PackageReference Include="Plugin.Firebase" Version="4.2.1" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />

  </ItemGroup>


  <!-- =========================================================
       FIREBASE ANDROID CONFIGURATION
       ========================================================= -->

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">

    <!--
      IMPORTANT:
      google-services.json must be located in the
      CCT_USCF project root.

      It must correspond to:

      Firebase project:
      cct-uscf

      Android package:
      com.uscf.cct
    -->

    <GoogleServicesJson Include="google-services.json" />

  </ItemGroup>


  <!-- =========================================================
       EXCLUDE NON-ANDROID TEST/LEGACY BACKEND FILES
       ========================================================= -->

  <ItemGroup>
    <Compile Remove="USCF.Backend.Tests\**\*.cs" />
    <None Remove="USCF.Backend.Tests\**\*" />
    <EmbeddedResource Remove="USCF.Backend.Tests\**\*" />
  </ItemGroup>

</Project>

