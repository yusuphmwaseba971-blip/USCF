<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.ChurchGroupSelectionPage"
    Title="Church Group"
    BackgroundColor="#FAF8F5">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            BackgroundColor="#1B4332"
            Padding="20,16"
            StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="‹"
                    FontSize="32"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="#F3F5F2"
                    Clicked="OnCancelClicked" />
                <Label
                    Grid.Column="1"
                    Text="Church Group"
                    FontSize="22"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    TextColor="#C4A574" />
                <Label
                    Grid.Column="2"
                    Text="Profile"
                    FontSize="13"
                    VerticalOptions="Center"
                    TextColor="#E4ECE7" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,26,20,24" Spacing="14">
                <Label
                    x:Name="DestinationLabel"
                    Text=""
                    FontSize="13"
                    TextColor="#64746C" />

                <Label
                    Text="Choose an organizational level"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#33443C"
                    Margin="0,0,0,6" />

                <Button
                    x:Name="NationalButton"
                    Text="🌐  National Group&#x0a;     Country-wide fellowship"
                    Clicked="OnNationalClicked"
                    Padding="16"
                    HeightRequest="82"
                    BackgroundColor="White"
                    TextColor="#176B78"
                    BorderColor="#B9DDE0"
                    BorderWidth="1"
                    CornerRadius="16"
                    HorizontalOptions="Fill" />

                <Button
                    x:Name="RegionalButton"
                    Text="◉  Regional Group&#x0a;     Regional fellowship"
                    Clicked="OnRegionalClicked"
                    Padding="16"
                    HeightRequest="82"
                    BackgroundColor="White"
                    TextColor="#51458A"
                    BorderColor="#D2CBEA"
                    BorderWidth="1"
                    CornerRadius="16"
                    HorizontalOptions="Fill" />

                <Button
                    x:Name="DistrictButton"
                    Text="🏛  District Group&#x0a;     District fellowship"
                    Clicked="OnDistrictClicked"
                    Padding="16"
                    HeightRequest="82"
                    BackgroundColor="White"
                    TextColor="#A56819"
                    BorderColor="#EAD5AE"
                    BorderWidth="1"
                    CornerRadius="16"
                    HorizontalOptions="Fill" />

                <Button
                    x:Name="BranchButton"
                    Text="✝  Branch Group&#x0a;     Local church fellowship"
                    Clicked="OnBranchClicked"
                    Padding="16"
                    HeightRequest="82"
                    BackgroundColor="White"
                    TextColor="#1B4332"
                    BorderColor="#BFD8C8"
                    BorderWidth="1"
                    CornerRadius="16"
                    HorizontalOptions="Fill" />

                <Label x:Name="StatusLabel" Text="" TextColor="#64746C" FontSize="13" />
                <VerticalStackLayout x:Name="GroupsLayout" Spacing="10" />

                <Button
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    Margin="0,10,0,0"
                    HeightRequest="48"
                    BackgroundColor="#F1F3F1"
                    BorderColor="#D7DFD9"
                    BorderWidth="1"
                    TextColor="#466153"
                    CornerRadius="14" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
