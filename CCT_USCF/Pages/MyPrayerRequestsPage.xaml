<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:CCT_USCF.Services"
    x:Class="CCT_USCF.Pages.MyPrayerRequestsPage"
    Title="{DynamicResource AppText_Prayer_YourPrayer}"
    BackgroundColor="{DynamicResource AppPageBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <services:LocalizedPrayerEnumConverter x:Key="LocalizedPrayerEnumConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="18,20" RowDefinitions="Auto,*">
        <VerticalStackLayout Spacing="4">
            <Label Text="{DynamicResource AppText_Prayer_YourPrayer}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Label Text="{DynamicResource AppText_Prayer_YourRequestsIntro}"
                   TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
        <CollectionView x:Name="RequestsCollectionView" Margin="0,18,0,0" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,52" Spacing="10" HorizontalOptions="Center">
                    <Label Text="🙏" FontSize="42" HorizontalOptions="Center" />
                    <Label Text="{DynamicResource AppText_Prayer_YourRequestsEmpty}"
                           FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{DynamicResource AppText_Prayer_ShareWithFamily}"
                           TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Padding="18" Margin="0,6"
                            Stroke="#DCEBE0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Category, Converter={StaticResource LocalizedPrayerEnumConverter}}" FontSize="12"
                                   FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                            <Label Text="{Binding Content}" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{DynamicResource AppText_Prayer_PostedPrefix}"
                                       FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding RelativeCreatedAt}"
                                       FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding PrayerCount, StringFormat='🙏  {0}'}"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                                <Label Text="{DynamicResource AppText_Prayer_PrayedWithYouSuffix}"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="{DynamicResource AppText_Prayer_IPray}"
                                        IsEnabled="False" BackgroundColor="#EAF7EE"
                                        TextColor="{StaticResource BrandGreen}" CornerRadius="14"
                                        Padding="12,7">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsPrayed}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource AppText_Prayer_IPrayedShort}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="{DynamicResource AppText_Prayer_Delete}" Clicked="OnDeleteClicked"
                                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                                        Padding="8,7" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout x:Name="LoadingState" IsVisible="False"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
            <ActivityIndicator IsRunning="True" Color="{StaticResource BrandGreen}" />
            <Label Text="{DynamicResource AppText_Prayer_LoadingMine}" TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="ErrorState" IsVisible="False"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            <Label x:Name="ErrorMessage" Text="{DynamicResource AppText_Prayer_LoadMineError}"
                   TextColor="#991B1B" HorizontalTextAlignment="Center" />
            <Button Text="{DynamicResource AppText_Prayer_TryAgain}" Clicked="OnRetryClicked"
                    BackgroundColor="{StaticResource BrandGreen}" TextColor="White" CornerRadius="14" />
        </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>