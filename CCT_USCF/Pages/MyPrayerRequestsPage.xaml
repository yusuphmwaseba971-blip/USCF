<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.MyPrayerRequestsPage"
    Title="My Prayer Requests"
    BackgroundColor="#F8FAFC">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="My Prayer Requests" FontSize="24" FontAttributes="Bold" TextColor="#1E40AF" />
        <Label Text="Your prayer requests will appear here." TextColor="#64748B" />

        <CollectionView x:Name="RequestsCollectionView" HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Padding="12" Margin="0,6">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Delete" Clicked="OnDeleteClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Back" Clicked="OnBackClicked" />
    </VerticalStackLayout>

</ContentPage>