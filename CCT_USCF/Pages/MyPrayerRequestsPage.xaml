<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.MyPrayerRequestsPage"
    Title="My Prayer"
    BackgroundColor="#F8FAFC">

    <Grid Padding="18,20" RowDefinitions="Auto,*">
        <VerticalStackLayout Spacing="4">
            <Label Text="My Prayer" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Label Text="Your prayer requests and the people standing with you."
                   TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
        <CollectionView x:Name="RequestsCollectionView" Margin="0,18,0,0" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,52" Spacing="10" HorizontalOptions="Center">
                    <Label Text="🙏" FontSize="42" HorizontalOptions="Center" />
                    <Label Text="Your prayer requests will appear here"
                           FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Share a prayer request with your USCF family and let others stand with you in prayer."
                           TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Padding="18" Margin="0,6"
                            Stroke="#DCEBE0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding CategoryLabel}" FontSize="12"
                                   FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                            <Label Text="{Binding Content}" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding RelativeCreatedAt, StringFormat='Posted {0}'}"
                                   FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding PrayerCount, StringFormat='🙏  {0} people prayed with you'}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="🙏  I PRAY"
                                        IsEnabled="False" BackgroundColor="#EAF7EE"
                                        TextColor="{StaticResource BrandGreen}" CornerRadius="14"
                                        Padding="12,7">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsPrayed}" Value="True">
                                            <Setter Property="Text" Value="✓  I PRAYED" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="Delete" Clicked="OnDeleteClicked"
                                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                                        Padding="8,7" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout x:Name="LoadingState" IsVisible="False"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
            <ActivityIndicator IsRunning="True" Color="{StaticResource BrandGreen}" />
            <Label Text="Loading your prayer requests..." TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="ErrorState" IsVisible="False"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
            <Label x:Name="ErrorMessage" Text="We couldn't load your prayer requests. Please check your connection and try again."
                   TextColor="#991B1B" HorizontalTextAlignment="Center" />
            <Button Text="Try Again" Clicked="OnRetryClicked"
                    BackgroundColor="{StaticResource BrandGreen}" TextColor="White" CornerRadius="14" />
        </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>