<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.ReportBugPage"
    Title="Report a Bug"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="14">
            <Label Text="Report a Bug" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Title" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Entry
                x:Name="TitleEntry"
                Placeholder="Short summary of the problem"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                TextColor="{StaticResource TextPrimary}"
                SemanticProperties.Description="Short title for the bug report" />

            <Label Text="What is the problem?" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Editor
                x:Name="DescriptionEditor"
                HeightRequest="120"
                AutoSize="TextChanges"
                Placeholder="Describe what went wrong"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                TextColor="{StaticResource TextPrimary}"
                SemanticProperties.Description="Describe the problem" />

            <Label Text="Where did it happen?" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Picker
                x:Name="CategoryPicker"
                Title="Select feature"
                ItemDisplayBinding="{Binding Name}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                TextColor="{StaticResource TextPrimary}"
                SemanticProperties.Description="Select where the problem happened" />

            <Label Text="What did you expect?" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Editor
                x:Name="ExpectedEditor"
                HeightRequest="100"
                AutoSize="TextChanges"
                Placeholder="Describe what you expected"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                TextColor="{StaticResource TextPrimary}"
                SemanticProperties.Description="Describe what you expected to happen" />

            <Label Text="What actually happened?" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Editor
                x:Name="ActualEditor"
                HeightRequest="100"
                AutoSize="TextChanges"
                Placeholder="Describe what happened instead"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                TextColor="{StaticResource TextPrimary}"
                SemanticProperties.Description="Describe what actually happened" />

            <Label Text="Add screenshot (optional)" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
            <Button
                x:Name="ScreenshotButton"
                Text="+ Add Screenshot"
                Clicked="OnAddScreenshotClicked"
                BackgroundColor="Transparent"
                BorderColor="{StaticResource BrandDeepGreen}"
                BorderWidth="1"
                TextColor="{StaticResource BrandDeepGreen}"
                CornerRadius="14"
                HeightRequest="50"
                SemanticProperties.Description="Choose a screenshot from this device" />
            <Image x:Name="ScreenshotPreview" HeightRequest="190" Aspect="AspectFit" IsVisible="False" />
            <Button
                x:Name="RemoveScreenshotButton"
                Text="Remove Screenshot"
                Clicked="OnRemoveScreenshotClicked"
                BackgroundColor="Transparent"
                TextColor="#8D4B4B"
                IsVisible="False"
                SemanticProperties.Description="Remove the selected screenshot" />

            <Label
                x:Name="StatusLabel"
                IsVisible="False"
                FontSize="14"
                TextColor="#B42318"
                LineBreakMode="WordWrap" />

            <ActivityIndicator x:Name="SubmitActivity" IsVisible="False" IsRunning="False" Color="{StaticResource BrandGreen}" />
            <Button
                x:Name="SubmitButton"
                Text="Submit Bug"
                Clicked="OnSubmitClicked"
                BackgroundColor="{StaticResource BrandDeepGreen}"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="54"
                SemanticProperties.Description="Submit bug report" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
