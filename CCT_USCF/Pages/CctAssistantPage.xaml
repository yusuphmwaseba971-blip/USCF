<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CCT_USCF.Pages.CctAssistantPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#55000000"
    Padding="0"
    Title="USCF Assistance">
    <Grid x:Name="Overlay" ColumnDefinitions="*,*"
          HorizontalOptions="Fill">
        <BoxView Grid.Column="0" BackgroundColor="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOutsideTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="Panel"
                Grid.Column="1"
                HorizontalOptions="End"
                BackgroundColor="#D91B2B35"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 26"
                Padding="10"
                VerticalOptions="Fill">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,3" Radius="18" Opacity="0.22" />
            </Border.Shadow>
            <Grid x:Name="AssistantLayout" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                    <Image Source="uscf_logo.png" WidthRequest="30" HeightRequest="30" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="USCF Assistance" FontSize="16" FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="ContextLabel" FontSize="12"
                               TextColor="#D0D7DE" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="×" FontSize="22" WidthRequest="36"
                            HeightRequest="36" Clicked="OnCloseClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource BrandGreen}"
                            Padding="0" />
                </Grid>
                <ScrollView Grid.Row="1" x:Name="ConversationScroll"
                            VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="How can I help you?" FontSize="16" TextColor="White" />
                        <VerticalStackLayout x:Name="QuickActionsLayout" Spacing="8" />
                        <ActivityIndicator x:Name="ThinkingIndicator" IsVisible="False" IsRunning="False"
                                           HorizontalOptions="Center" Color="{StaticResource BrandGreen}" />
                        <VerticalStackLayout x:Name="ResponseLayout" IsVisible="False" Spacing="8" />
                        <Button x:Name="CopyResponseButton" Text="Copy" IsVisible="False"
                                Clicked="OnCopyResponseClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource BrandGreen}"
                                HorizontalOptions="Start" Padding="4,2" />
                        <VerticalStackLayout x:Name="ActionLayout" IsVisible="False" Spacing="8">
                            <VerticalStackLayout x:Name="ContextualActionsLayout" Spacing="8" />
                            <Button Text="Dismiss" Clicked="OnDismissActionClicked"
                                    BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                <Grid x:Name="InputGrid" Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="4"
                      Padding="0,4,0,0"
                      VerticalOptions="End">
                    <Editor x:Name="PromptEditor"
                            Grid.Column="0"
                            Placeholder="Ask USCF for assistance..."
                            AutoSize="Disabled" HeightRequest="60"
                            MinimumHeightRequest="48" MaximumHeightRequest="120"
                            VerticalOptions="Start" TextChanged="OnPromptTextChanged"
                            TextColor="White"
                            PlaceholderColor="#B8C4CC" />
                    <Button x:Name="AskSurface"
                            Grid.Column="1"
                            Text=">"
                            FontSize="20"
                            WidthRequest="52"
                            HeightRequest="48"
                            Padding="8,0"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource AccentPurple}"
                            TextColor="White"
                            Clicked="OnAskClicked" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
