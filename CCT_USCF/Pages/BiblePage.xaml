<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.BiblePage"
    Title="Bible"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="📖 Holy Bible"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1E40AF" />

            <Label
                Text="Read and explore God's Word."
                FontSize="17"
                TextColor="#64748B" />

            <SearchBar
                Placeholder="Search the Bible..." />

            <Button
                Text="Old Testament"
                FontSize="18" />

            <Button
                Text="New Testament"
                FontSize="18" />

            <Border
                BackgroundColor="White"
                Padding="20"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="📌 Featured Verse"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="For God so loved the world..."
                        FontSize="17" />

                    <Label
                        Text="John 3:16"
                        TextColor="#64748B" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>