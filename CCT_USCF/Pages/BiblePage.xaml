<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CCT_USCF.Pages.BiblePage"
             Title="Bible"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="8,6" ColumnDefinitions="Auto,*,Auto,Auto"
              BackgroundColor="{StaticResource BrandDeepGreen}">
            <Button x:Name="BackButton" Grid.Column="0" Text="‹" FontSize="30" Padding="8,0"
                    IsVisible="False" Clicked="OnBackClicked"
                    TextColor="{StaticResource White}" BackgroundColor="Transparent"
                    AutomationProperties.Name="Back" />
            <Label x:Name="PageTitle" Grid.Column="1" Text="BIBLIA"
                   VerticalOptions="Center" FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource White}" />
            <Button Grid.Column="2" Text="Search" Clicked="OnSearchClicked"
                    TextColor="{StaticResource White}" BackgroundColor="Transparent" />
            <Button Grid.Column="3" Text="⋮" FontSize="24" Clicked="OnMoreClicked"
                    TextColor="{StaticResource White}" BackgroundColor="Transparent"
                    AutomationProperties.Name="Bible options" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Padding="12,8,12,12">
            <SearchBar x:Name="SearchBox" Grid.Row="0" Placeholder="Search this translation"
                       IsVisible="False" SearchButtonPressed="OnSearchPressed" />
            <CollectionView x:Name="SearchResults" Grid.Row="0" IsVisible="False"
                            SelectionMode="Single" SelectionChanged="OnSearchResultSelected"
                            MaximumHeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8" ColumnDefinitions="Auto,*">
                            <Label Text="{Binding Reference}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BibleAccentLight}, Dark={StaticResource BibleAccentDark}}" />
                            <Label Grid.Column="1" Text="{Binding Text}" LineBreakMode="TailTruncation"
                                   Margin="10,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid Grid.Row="1">
                <Grid x:Name="BooksPanel" IsVisible="True" RowDefinitions="Auto,Auto,*">
                    <Label x:Name="BooksHeading" Grid.Row="0" Text="OLD TESTAMENT" FontSize="13"
                           CharacterSpacing="1.5" Padding="8,8,8,12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource Gray300}}" />
                    <Label x:Name="BooksStatusLabel" Grid.Row="1" Text="Opening Bible…" IsVisible="True"
                           Padding="12" HorizontalTextAlignment="Center" />
                    <CollectionView x:Name="BooksList" Grid.Row="2" SelectionMode="Single"
                                    SelectionChanged="OnBookSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,14" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontSize="18" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="›" FontSize="24" Opacity="0.6"
                                           VerticalOptions="Center" />
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1"
                                             VerticalOptions="End"
                                             Color="{AppThemeBinding Light={StaticResource UscfBorder}, Dark={StaticResource Gray600}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <VerticalStackLayout x:Name="ChaptersPanel" IsVisible="False" Spacing="0">
                    <Label x:Name="ChaptersHeading" Text="CHAPTERS" FontSize="13"
                           CharacterSpacing="1.5" Padding="8,8,8,12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource Gray300}}" />
                    <CollectionView x:Name="ChaptersList" SelectionMode="None"
                                    ItemsLayout="VerticalGrid, 4">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding .}" FontSize="22" FontAttributes="Bold"
                                        Padding="8,18" Margin="3" Clicked="OnChapterClicked"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Grid x:Name="ReaderPanel" IsVisible="False" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Padding="0,0,0,8">
                        <Button x:Name="PreviousChapterButton" Grid.Column="0" Text="‹"
                                Clicked="OnPreviousChapterClicked" HorizontalOptions="Start" />
                        <Label x:Name="VerseHeading" Grid.Column="1" Text="SURA YA 1"
                               FontSize="18" VerticalOptions="Center" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource BibleTextLight}, Dark={StaticResource BibleTextDark}}" />
                        <Button x:Name="NextChapterButton" Grid.Column="2" Text="›"
                                Clicked="OnNextChapterClicked" HorizontalOptions="End" />
                    </Grid>

                    <CollectionView x:Name="VerseList" Grid.Row="1" SelectionMode="Single"
                                    SelectionChanged="OnVerseSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" Margin="0,1" StrokeThickness="0"
                                        BackgroundColor="{Binding Background}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Label Text="{Binding Number}" FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource BibleAccentLight}, Dark={StaticResource BibleAccentDark}}" />
                                        <Label Grid.Column="1" Text="{Binding Text}"
                                               FontSize="{Binding FontSize}" LineHeight="1.35"
                                               Margin="10,0,0,0"
                                               TextColor="{AppThemeBinding Light={StaticResource BibleTextLight}, Dark={StaticResource BibleTextDark}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>

            <Grid x:Name="VerseActions" Grid.Row="2" IsVisible="False"
                  VerticalOptions="End" HorizontalOptions="Center"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" Padding="0,8">
                <Button Text="Copy" Grid.Column="0" Clicked="OnCopyVerseClicked" />
                <Button Text="Note" Grid.Column="1" Clicked="OnNoteVerseClicked" />
                <Button Text="★" Grid.Column="2" Clicked="OnBookmarkVerseClicked" />
                <Button Text="Highlight" Grid.Column="3" Clicked="OnHighlightVerseClicked" />
                <Button Text="Share" Grid.Column="4" Clicked="OnShareVerseClicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
