<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.CommunityPage"
    Title="{DynamicResource AppText_Community_Title}"
    BackgroundColor="{DynamicResource AppPageBackground}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,0,16,28" Spacing="16">
                <Border Padding="22,26,22,28" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,30,30">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource BrandDeepGreen}" Offset="0" />
                            <GradientStop Color="{StaticResource BrandGreen}" Offset="0.65" />
                            <GradientStop Color="{StaticResource BrandGreenLight}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Label Text="✝" FontSize="112" TextColor="White" Opacity="0.08"
                               HorizontalOptions="End" VerticalOptions="End" TranslationY="28" />
                        <VerticalStackLayout Spacing="7">
                            <Label Text="♧" FontSize="28" TextColor="#D6F5E0" />
                            <Label Text="{DynamicResource AppText_Community_Title}" FontSize="34" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{DynamicResource AppText_Community_Connect}" FontSize="17"
                                   TextColor="#E7F8EC" />
                            <Label Text="{DynamicResource AppText_Community_TogetherInChrist}" FontSize="13" FontAttributes="Italic"
                                   TextColor="#C9EED5" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="18,16" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="{DynamicResource AppText_Community_CreatePostDescription}">
                    <Border.Shadow>
                        <Shadow Brush="#173B28" Offset="0,3" Radius="12" Opacity="0.10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreatePostClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource SoftMint}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 24">
                            <Label Text="＋" FontSize="28" TextColor="{StaticResource BrandGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{DynamicResource AppText_Community_CreatePost}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{DynamicResource AppText_Community_SharePrompt}" FontSize="12" TextColor="#718096" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="30" TextColor="#087A32"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Padding="20" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        SemanticProperties.Description="{DynamicResource AppText_Community_FeedDescription}">
                    <Border.Shadow>
                        <Shadow Brush="#173B28" Offset="0,4" Radius="14" Opacity="0.10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFullCommunityClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="54" HeightRequest="54" BackgroundColor="{StaticResource SoftMint}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 27">
                                <Label Text="♧" FontSize="32" TextColor="{StaticResource BrandGreen}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{DynamicResource AppText_Community_ChurchCommunity}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{DynamicResource AppText_Community_Belong}" FontSize="13" TextColor="#718096" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{DynamicResource AppText_Community_Welcome}"
                               FontSize="15" TextColor="#334155" LineHeight="1.15" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <Label Text="{DynamicResource AppText_Community_Explore}" FontSize="13" TextColor="#087A32" />
                            <Label Grid.Column="1" Text="›" FontSize="25" TextColor="#087A32" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{DynamicResource AppText_Community_Discover}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                       Margin="2,3,0,0" />

                <Border Padding="16" BackgroundColor="{StaticResource AccentBlueTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="{DynamicResource AppText_Community_OpenPrayer}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrayerRequestsClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#D7ECFF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 25">
                            <Label Text="♡" FontSize="31" TextColor="{StaticResource AccentBlue}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{DynamicResource AppText_Home_PrayerRequests}" FontSize="17" FontAttributes="Bold" TextColor="#123B73" />
                            <Label Text="{DynamicResource AppText_Community_PrayerDescription}" FontSize="12" TextColor="#54708B" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="29" TextColor="#1769AA"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Padding="16" BackgroundColor="{StaticResource AccentPurpleTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="{DynamicResource AppText_Community_OpenAnnouncements}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChurchAnnouncementsClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#E8DDFF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 25">
                            <Label Text="!" FontSize="30" FontAttributes="Bold" TextColor="#6B46C1"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{DynamicResource AppText_Community_Announcements}" FontSize="17" FontAttributes="Bold" TextColor="#38216B" />
                            <Label Text="{DynamicResource AppText_Community_AnnouncementsDescription}" FontSize="12" TextColor="#75658F" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="29" TextColor="#6B46C1"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Padding="16" BackgroundColor="#FFF8E7" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="{DynamicResource AppText_Community_OpenGroups}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChurchGroupsClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#FFEDB7"
                                StrokeThickness="0" StrokeShape="RoundRectangle 25">
                            <Label Text="♧" FontSize="31" TextColor="#A66A00"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{DynamicResource AppText_Community_Groups}" FontSize="17" FontAttributes="Bold" TextColor="#684400" />
                            <Label Text="{DynamicResource AppText_Community_GroupsDescription}" FontSize="12" TextColor="#8A7045" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="29" TextColor="#A66A00"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
