<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.CommunityPage"
    Title="Community"
    BackgroundColor="#F4F8F5">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,0,16,28" Spacing="16">
                <Border Padding="22,26,22,28" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,30,30">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#075E36" Offset="0" />
                            <GradientStop Color="#009E2C" Offset="0.65" />
                            <GradientStop Color="#36B96A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Label Text="✝" FontSize="112" TextColor="White" Opacity="0.08"
                               HorizontalOptions="End" VerticalOptions="End" TranslationY="28" />
                        <VerticalStackLayout Spacing="7">
                            <Label Text="♧" FontSize="28" TextColor="#D6F5E0" />
                            <Label Text="Community" FontSize="34" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Connect, encourage and grow together." FontSize="17"
                                   TextColor="#E7F8EC" />
                            <Label Text="Together in Christ" FontSize="13" FontAttributes="Italic"
                                   TextColor="#C9EED5" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="18,16" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="Create a post">
                    <Border.Shadow>
                        <Shadow Brush="#173B28" Offset="0,3" Radius="12" Opacity="0.10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreatePostClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E2F5E8"
                                StrokeThickness="0" StrokeShape="RoundRectangle 24">
                            <Label Text="＋" FontSize="28" TextColor="#087A32"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Create Post" FontSize="18" FontAttributes="Bold" TextColor="#102A20" />
                            <Label Text="Share your thoughts, prayers or testimony" FontSize="12" TextColor="#718096" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="30" TextColor="#087A32"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Padding="20" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        SemanticProperties.Description="Open the Church Community feed">
                    <Border.Shadow>
                        <Shadow Brush="#173B28" Offset="0,4" Radius="14" Opacity="0.10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFullCommunityClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border WidthRequest="54" HeightRequest="54" BackgroundColor="#E4F4E9"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 27">
                                <Label Text="♧" FontSize="32" TextColor="#087A32"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Church Community" FontSize="21" FontAttributes="Bold" TextColor="#102A20" />
                                <Label Text="A place to share and belong" FontSize="13" TextColor="#718096" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Welcome to the CCT community. Share encouragement, Bible verses and testimonies."
                               FontSize="15" TextColor="#334155" LineHeight="1.15" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <Label Text="Explore the community feed" FontSize="13" TextColor="#087A32" />
                            <Label Grid.Column="1" Text="›" FontSize="25" TextColor="#087A32" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Discover" FontSize="21" FontAttributes="Bold" TextColor="#102A20"
                       Margin="2,3,0,0" />

                <Border Padding="16" BackgroundColor="#EAF5FF" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="Open Prayer Requests">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrayerRequestsClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#D7ECFF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 25">
                            <Label Text="♡" FontSize="31" TextColor="#1769AA"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Prayer Requests" FontSize="17" FontAttributes="Bold" TextColor="#123B73" />
                            <Label Text="Share your needs and stand with others." FontSize="12" TextColor="#54708B" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="29" TextColor="#1769AA"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Padding="16" BackgroundColor="#F3EDFF" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="Open Church Announcements">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChurchAnnouncementsClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#E8DDFF"
                                StrokeThickness="0" StrokeShape="RoundRectangle 25">
                            <Label Text="!" FontSize="30" FontAttributes="Bold" TextColor="#6B46C1"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Church Announcements" FontSize="17" FontAttributes="Bold" TextColor="#38216B" />
                            <Label Text="Stay updated with church news and events." FontSize="12" TextColor="#75658F" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="29" TextColor="#6B46C1"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Padding="16" BackgroundColor="#FFF8E7" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        SemanticProperties.Description="Open Church Groups">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChurchGroupsClicked" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="50" HeightRequest="50" BackgroundColor="#FFEDB7"
                                StrokeThickness="0" StrokeShape="RoundRectangle 25">
                            <Label Text="♧" FontSize="31" TextColor="#A66A00"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Church Groups" FontSize="17" FontAttributes="Bold" TextColor="#684400" />
                            <Label Text="Connect and grow in faith together." FontSize="12" TextColor="#8A7045" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="29" TextColor="#A66A00"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
