<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CCT_USCF.Pages.AnnouncementDetailPage"
             Title="Announcement"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <ScrollView>
        <VerticalStackLayout Padding="20,22,20,32" Spacing="16">
            <Label x:Name="ScopeLabel" TextColor="#A98232" FontAttributes="Bold" FontSize="12" />
            <Label x:Name="TitleLabel" TextColor="{AppThemeBinding Light=#173C2C, Dark=#F1F7F2}" FontAttributes="Bold" FontSize="28" />
            <Label x:Name="MetaLabel" TextColor="{AppThemeBinding Light=#78857B, Dark=#B9C9BE}" FontSize="12" />
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D9E2DB, Dark=#4D5C52}" />
            <Image x:Name="AnnouncementImage" IsVisible="False" HeightRequest="220" Aspect="AspectFill" />
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource UscfBorder}, Dark={StaticResource Gray600}}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">
                <Label x:Name="MessageLabel"
                       TextColor="{AppThemeBinding Light=#2F4035, Dark=#E0EBE3}"
                       FontSize="16"
                       LineHeight="1.35" />
            </Border>
            <Label x:Name="IssuedByLabel" TextColor="{AppThemeBinding Light=#78857B, Dark=#B9C9BE}" FontSize="13" />
            <Label x:Name="ReadStateLabel" TextColor="#A98232" FontAttributes="Bold" FontSize="12" />
            <HorizontalStackLayout Spacing="10">
                <Button x:Name="MarkReadButton" Text="MARK AS READ" Clicked="OnMarkReadClicked" />
                <Button Text="SHARE" Clicked="OnShareClicked" />
                <Button Text="REMINDER" Clicked="OnReminderClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
