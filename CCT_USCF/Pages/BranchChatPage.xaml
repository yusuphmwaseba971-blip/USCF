<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.BranchChatPage"
    Title="Branch Group"
    BackgroundColor="#FAF8F5">

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Padding="0">

        <!-- ====================================================== -->
        <!-- HEADER                                                  -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="0"
            BackgroundColor="#1A4D3A"
            Padding="18,14,18,16"
            StrokeThickness="0">

            <VerticalStackLayout
                Spacing="3">

                <Label
                    x:Name="BranchTitleLabel"
                    Text="Branch Group"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#B8986B" />

                <Label
                    x:Name="BranchStatusLabel"
                    Text="Loading Branch Group..."
                    FontSize="12"
                    TextColor="#DCE8E1" />

            </VerticalStackLayout>

        </Border>


        <!-- ====================================================== -->
        <!-- MEMBERS                                                 -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="1"
            Margin="12,8,12,0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">

            <Border
                Grid.Column="0"
                BackgroundColor="White"
                Padding="14,11"
                Stroke="#E7E1D8"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <Label
                    x:Name="MembersLabel"
                    Text="Members"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#33443C" />

            </Border>

            <Button
                x:Name="AddMemberButton"
                Grid.Column="1"
                Text="+ Add Member"
                Padding="14,9"
                FontSize="12"
                BackgroundColor="#1A4D3A"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="44" />

        </Grid>


        <!-- ====================================================== -->
        <!-- MESSAGES + PULL TO REFRESH                              -->
        <!-- ====================================================== -->

        <RefreshView
            x:Name="MessagesRefreshView"
            Grid.Row="2"
            Refreshing="OnMessagesRefreshing">

            <ScrollView
                Padding="14,14,14,4">

                <VerticalStackLayout
                    x:Name="MessagesLayout"
                    Spacing="12" />

            </ScrollView>

        </RefreshView>


        <!-- ====================================================== -->
        <!-- MESSAGE COMPOSER                                        -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="3"
            BackgroundColor="White"
            Margin="10,6,10,10"
            Padding="10,10"
            Stroke="#E7E1D8"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18">

            <VerticalStackLayout Spacing="8">

                <Grid
                    x:Name="PendingAttachmentLayout"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="8"
                    IsVisible="False">

                    <Image
                        x:Name="PendingAttachmentImage"
                        Grid.Column="0"
                        WidthRequest="52"
                        HeightRequest="52"
                        Aspect="AspectFill" />

                    <Label
                        x:Name="PendingAttachmentLabel"
                        Grid.Column="1"
                        VerticalOptions="Center"
                        TextColor="#1A4D3A"
                        LineBreakMode="TailTruncation" />

                    <Button
                        Grid.Column="2"
                        Text="Remove"
                        Clicked="OnRemoveAttachmentClicked"
                        Padding="8,4"
                        FontSize="12"
                        BackgroundColor="Transparent"
                        TextColor="#B91C1C" />
                </Grid>

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="8">

                <!-- ATTACHMENT BUTTON -->

                <Button
                    x:Name="AttachmentButton"
                    Grid.Column="0"
                    Text="📎"
                    FontSize="22"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="#64746C"
                    Clicked="OnAttachmentClicked"
                    VerticalOptions="Center" />

                <!-- MESSAGE ENTRY -->

                <Entry
                    x:Name="MessageEntry"
                    Grid.Column="1"
                    Placeholder="Message this Branch..."
                    PlaceholderColor="#94A39A"
                    BackgroundColor="#FAF8F5"
                    TextColor="#26362E"
                    VerticalOptions="Center" />

                <!-- SEND BUTTON -->

                <Button
                    Grid.Column="2"
                    Text="Send"
                    Clicked="OnSendClicked"
                    Padding="16,9"
                    BackgroundColor="#1A4D3A"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="44"
                    VerticalOptions="Center" />

                </Grid>
            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>