<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.ProfilePage"
    Title="{DynamicResource AppText_Profile_Title}"
    BackgroundColor="{DynamicResource AppPageBackground}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="0">
            <Border
                Padding="24,24,24,28"
                BackgroundColor="#1A4D3A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,28,28">
                <Grid>
                    <Label
                        Text="✚"
                        FontSize="112"
                        TextColor="#FFFFFF"
                        Opacity="0.06"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        TranslationY="34" />
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="{DynamicResource AppText_Profile_Account}"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="2"
                            TextColor="#D9C39E" />
                        <Label
                            Text="{DynamicResource AppText_Profile_MyProfile}"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <BoxView
                            HeightRequest="2"
                            WidthRequest="42"
                            HorizontalOptions="Start"
                            Color="#B8986B"
                            Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="16,18,16,32" Spacing="16">
                <Border
                    Padding="20,24,20,20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                    Stroke="#E8DCCB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22">
                    <Border.Shadow>
                        <Shadow Brush="#173B28" Offset="0,4" Radius="16" Opacity="0.10" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="18">
                        <Grid HeightRequest="104">
                            <Border
                                WidthRequest="98"
                                HeightRequest="98"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                                Stroke="#B8986B"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 49"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Border
                                    Margin="5"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftMint}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="#D9C39E"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 44">
                                    <Label
                                        Text="♙"
                                        FontSize="52"
                                        TextColor="#1A4D3A"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                            </Border>
                            <Border
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="#1A4D3A"
                                Stroke="#FFFFFF"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 15"
                                HorizontalOptions="Center"
                                VerticalOptions="End"
                                TranslationX="35"
                                TranslationY="2">
                                <Label
                                    Text="✎"
                                    FontSize="14"
                                    TextColor="#FFFFFF"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label
                                x:Name="FullNameLabel"
                                Text="{DynamicResource AppText_Profile_FullName}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="{DynamicResource AppText_Profile_Member}"
                                FontSize="12"
                                CharacterSpacing="1"
                                TextColor="#8B7658"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EFE8DE" />

                        <VerticalStackLayout Spacing="11">
                            <Label
                                Text="{DynamicResource AppText_Profile_Contact}"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4"
                                TextColor="#1A4D3A" />
                            <Label
                                x:Name="UsernameLabel"
                                Text="{DynamicResource AppText_Profile_Username}"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}"
                                LineBreakMode="WordWrap" />
                            <Label
                                x:Name="EmailLabel"
                                Text="{DynamicResource AppText_Profile_Email}"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}"
                                LineBreakMode="CharacterWrap" />
                            <Label
                                x:Name="PhoneNumberLabel"
                                Text="{DynamicResource AppText_Profile_Phone}"
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EFE8DE" />

                        <VerticalStackLayout Spacing="11">
                            <Label
                                Text="{DynamicResource AppText_Profile_Membership}"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4"
                                TextColor="#1A4D3A" />
                            <Grid
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="10">
                                <Label x:Name="RoleLabel" Text="{DynamicResource AppText_Profile_Role}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                                <Label x:Name="BranchLabel" Grid.Column="1" Text="{DynamicResource AppText_Profile_Branch}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                                <Label x:Name="RegionLabel" Grid.Row="1" Text="{DynamicResource AppText_Profile_Region}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                                <Label x:Name="DistrictLabel" Grid.Row="1" Grid.Column="1" Text="{DynamicResource AppText_Profile_District}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                            </Grid>
                        </VerticalStackLayout>

                        <Button
                            x:Name="LogoutButton"
                            Text="{DynamicResource AppText_Profile_SignOut}"
                            FontSize="13"
                            TextColor="#8D4B4B"
                            BackgroundColor="{AppThemeBinding Light=#FFF8F6, Dark={StaticResource SurfaceDark}}"
                            BorderColor="#E8CFCB"
                            BorderWidth="1"
                            CornerRadius="12"
                            Padding="12,8"
                            HorizontalOptions="Center"
                            Clicked="OnLogoutClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="{DynamicResource AppText_Profile_YourUscf}"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="1.5"
                    TextColor="#8B7658"
                    Margin="2,4,0,0" />

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid x:Name="SavedVersesCard" Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F6F0E7, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="▤" FontSize="24" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{DynamicResource AppText_Profile_SavedVerses}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="SavedVersesButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnSavedVersesClicked" />
                    </Grid>
                    <Grid x:Name="PrayerRequestsCard" Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F6F0E7, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="♡" FontSize="28" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{DynamicResource AppText_Profile_MyPrayerRequests}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="PrayerRequestsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnPrayerRequestsClicked" />
                    </Grid>
                    <Grid x:Name="SavedSermonsCard" Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F6F0E7, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="▥" FontSize="24" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{DynamicResource AppText_Profile_SavedSermons}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="SavedSermonsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnSavedSermonsClicked" />
                    </Grid>
                    <Grid x:Name="EventsCard" Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F6F0E7, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="□" FontSize="27" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{DynamicResource AppText_Profile_MyEvents}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="EventsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnEventsClicked" />
                    </Grid>
                    <Grid x:Name="RateUsCard" Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F9F2D8, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="⭐" FontSize="24" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{DynamicResource AppText_Profile_RateUscf}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{DynamicResource AppText_Profile_RatePrompt}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="RateUsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnRateUsClicked" />
                    </Grid>
                    <Grid x:Name="SupportCard" Row="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light={StaticResource SoftMint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="💬" FontSize="24" TextColor="#1A4D3A" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{DynamicResource AppText_Profile_HelpSupport}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{DynamicResource AppText_Profile_HelpPrompt}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="HelpSupportButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnHelpSupportClicked" />
                    </Grid>
                    <Grid x:Name="SettingsCard" Row="6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F6F0E7, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="⚙" FontSize="24" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{DynamicResource AppText_Profile_Settings}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="SettingsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnSettingsClicked" />
                    </Grid>
                    <Grid x:Name="AboutCctUsfcCard" Row="7" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light={StaticResource SoftMint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="ℹ" FontSize="25" TextColor="#1A4D3A" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="ABOUT CCT-USCF" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Learn about the history, mission, leadership and official information of CCT-USCF." FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="AboutCctUsfcButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnAboutCctUsfcClicked" />
                    </Grid>
                </Grid>

                <Button
                    x:Name="LogoutButtonBottom"
                    Text="{DynamicResource AppText_Profile_Logout}"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#8D4B4B"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                    BorderColor="#E8CFCB"
                    BorderWidth="1"
                    CornerRadius="16"
                    HeightRequest="58"
                    Clicked="OnLogoutClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
