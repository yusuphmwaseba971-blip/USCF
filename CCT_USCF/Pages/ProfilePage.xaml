<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.ProfilePage"
    Title="Profile"
    BackgroundColor="#FAF8F5">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="0">
            <Border
                Padding="24,24,24,28"
                BackgroundColor="#1A4D3A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,28,28">
                <Grid>
                    <Label
                        Text="✚"
                        FontSize="112"
                        TextColor="#FFFFFF"
                        Opacity="0.06"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        TranslationY="34" />
                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="ACCOUNT"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="2"
                            TextColor="#D9C39E" />
                        <Label
                            Text="My Profile"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <BoxView
                            HeightRequest="2"
                            WidthRequest="42"
                            HorizontalOptions="Start"
                            Color="#B8986B"
                            Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Padding="16,18,16,32" Spacing="16">
                <Border
                    Padding="20,24,20,20"
                    BackgroundColor="#FFFFFF"
                    Stroke="#E8DCCB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22">
                    <Border.Shadow>
                        <Shadow Brush="#173B28" Offset="0,4" Radius="16" Opacity="0.10" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="18">
                        <Grid HeightRequest="104">
                            <Border
                                WidthRequest="98"
                                HeightRequest="98"
                                BackgroundColor="#FFFFFF"
                                Stroke="#B8986B"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 49"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Border
                                    Margin="5"
                                    BackgroundColor="#EAF2ED"
                                    Stroke="#D9C39E"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 44">
                                    <Label
                                        Text="♙"
                                        FontSize="52"
                                        TextColor="#1A4D3A"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                            </Border>
                            <Border
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="#1A4D3A"
                                Stroke="#FFFFFF"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 15"
                                HorizontalOptions="Center"
                                VerticalOptions="End"
                                TranslationX="35"
                                TranslationY="2">
                                <Label
                                    Text="✎"
                                    FontSize="14"
                                    TextColor="#FFFFFF"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label
                                x:Name="FullNameLabel"
                                Text="Full Name"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#172B23"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="CCT-USCF member"
                                FontSize="12"
                                CharacterSpacing="1"
                                TextColor="#8B7658"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EFE8DE" />

                        <VerticalStackLayout Spacing="11">
                            <Label
                                Text="CONTACT INFORMATION"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4"
                                TextColor="#1A4D3A" />
                            <Label
                                x:Name="UsernameLabel"
                                Text="Username"
                                FontSize="14"
                                TextColor="#52645B"
                                LineBreakMode="WordWrap" />
                            <Label
                                x:Name="EmailLabel"
                                Text="Email"
                                FontSize="14"
                                TextColor="#52645B"
                                LineBreakMode="CharacterWrap" />
                            <Label
                                x:Name="PhoneNumberLabel"
                                Text="Phone Number"
                                FontSize="14"
                                TextColor="#52645B"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EFE8DE" />

                        <VerticalStackLayout Spacing="11">
                            <Label
                                Text="MEMBERSHIP DETAILS"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4"
                                TextColor="#1A4D3A" />
                            <Grid
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="10">
                                <Label x:Name="RoleLabel" Text="Role" FontSize="14" TextColor="#52645B" LineBreakMode="WordWrap" />
                                <Label x:Name="BranchLabel" Grid.Column="1" Text="USCF Branch" FontSize="14" TextColor="#52645B" LineBreakMode="WordWrap" />
                                <Label x:Name="RegionLabel" Grid.Row="1" Text="Region" FontSize="14" TextColor="#52645B" LineBreakMode="WordWrap" />
                                <Label x:Name="DistrictLabel" Grid.Row="1" Grid.Column="1" Text="District" FontSize="14" TextColor="#52645B" LineBreakMode="WordWrap" />
                            </Grid>
                        </VerticalStackLayout>

                        <Button
                            x:Name="LogoutButton"
                            Text="Sign out"
                            FontSize="13"
                            TextColor="#8D4B4B"
                            BackgroundColor="#FFF8F6"
                            BorderColor="#E8CFCB"
                            BorderWidth="1"
                            CornerRadius="12"
                            Padding="12,8"
                            HorizontalOptions="Center"
                            Clicked="OnLogoutClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="YOUR CCT-USCF"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="1.5"
                    TextColor="#8B7658"
                    Margin="2,4,0,0" />

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Grid x:Name="SavedVersesCard" Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="#FFFFFF" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="#F6F0E7" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="▤" FontSize="24" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Saved Bible Verses" FontSize="16" FontAttributes="Bold" TextColor="#172B23" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="SavedVersesButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnSavedVersesClicked" />
                    </Grid>
                    <Grid x:Name="PrayerRequestsCard" Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="#FFFFFF" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="#F6F0E7" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="♡" FontSize="28" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="My Prayer Requests" FontSize="16" FontAttributes="Bold" TextColor="#172B23" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="PrayerRequestsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnPrayerRequestsClicked" />
                    </Grid>
                    <Grid x:Name="SavedSermonsCard" Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="#FFFFFF" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="#F6F0E7" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="▥" FontSize="24" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Saved Sermons" FontSize="16" FontAttributes="Bold" TextColor="#172B23" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="SavedSermonsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnSavedSermonsClicked" />
                    </Grid>
                    <Grid x:Name="EventsCard" Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="#FFFFFF" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="#F6F0E7" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="□" FontSize="27" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="My Events" FontSize="16" FontAttributes="Bold" TextColor="#172B23" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="EventsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnEventsClicked" />
                    </Grid>
                    <Grid x:Name="SettingsCard" Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3" BackgroundColor="#FFFFFF" Stroke="#EEE7DE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <Border.Shadow><Shadow Brush="#173B28" Offset="0,2" Radius="8" Opacity="0.06" /></Border.Shadow>
                        </Border>
                        <Border Padding="12" WidthRequest="48" HeightRequest="48" BackgroundColor="#F6F0E7" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label Text="⚙" FontSize="24" TextColor="#8B7658" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Settings" FontSize="16" FontAttributes="Bold" TextColor="#172B23" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#B8986B" VerticalOptions="Center" />
                        <Button x:Name="SettingsButton" Grid.ColumnSpan="3" Text="" BackgroundColor="Transparent" Clicked="OnSettingsClicked" />
                    </Grid>
                </Grid>

                <Button
                    x:Name="LogoutButtonBottom"
                    Text="⇥   Logout"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#8D4B4B"
                    BackgroundColor="#FFFFFF"
                    BorderColor="#E8CFCB"
                    BorderWidth="1"
                    CornerRadius="16"
                    HeightRequest="58"
                    Clicked="OnLogoutClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
