<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.ProfilePage"
    Title="Profile"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="👤 My Profile"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1E40AF" />

            <Border
                BackgroundColor="White"
                Padding="25"
                StrokeThickness="0">

                <VerticalStackLayout
                    Spacing="10"
                    HorizontalOptions="Center">

                    <Label
                        Text="👤"
                        FontSize="60"
                        HorizontalOptions="Center" />

                            <Label
                                x:Name="FullNameLabel"
                                Text="Full Name"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalOptions="Start" />

                            <Label
                                x:Name="UsernameLabel"
                                Text="Username"
                                TextColor="#64748B"
                                HorizontalOptions="Start" />

                            <Label
                                x:Name="EmailLabel"
                                Text="Email"
                                TextColor="#64748B"
                                HorizontalOptions="Start" />

                            <Label
                                x:Name="RoleLabel"
                                Text="Role"
                                TextColor="#64748B"
                                HorizontalOptions="Start" />

                            <Label
                                x:Name="RegionLabel"
                                Text="Region"
                                TextColor="#64748B"
                                HorizontalOptions="Start" />

                            <Label
                                x:Name="DistrictLabel"
                                Text="District"
                                TextColor="#64748B"
                                HorizontalOptions="Start" />

                            <Label
                                x:Name="BranchLabel"
                                Text="USCF Branch"
                                TextColor="#64748B"
                                HorizontalOptions="Start" />

                            <Button
                                x:Name="LogoutButton"
                                Text="🚪 Logout"
                                Clicked="OnLogoutClicked" />

                </VerticalStackLayout>

            </Border>

            <Button
                Text="📖 Saved Bible Verses" />

            <Button
                Text="🙏 My Prayer Requests" />

            <Button
                Text="🎥 Saved Sermons" />

            <Button
                Text="📅 My Events" />

            <Button
                Text="⚙️ Settings" />

            <Button
                Text="🚪 Logout" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>