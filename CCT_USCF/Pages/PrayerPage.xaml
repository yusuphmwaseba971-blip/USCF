<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.PrayerPage"
    Title="Prayer"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" StrokeThickness="0" Padding="24,26,24,28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource BrandDeepGreen}" Offset="0" />
                    <GradientStop Color="{StaticResource BrandGreen}" Offset="0.62" />
                    <GradientStop Color="{StaticResource BrandGreenLight}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Label Text="✝" FontSize="112" TextColor="#FFFFFF" Opacity="0.08"
                       HorizontalOptions="End" VerticalOptions="End" TranslationY="24" />
                <VerticalStackLayout Spacing="8">
                    <Label Text="🙏" FontSize="28" />
                    <Label Text="Prayer Community" FontSize="30" FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Let us pray for one another." FontSize="16"
                           TextColor="#E6F7EC" />
                    <Label Text="&quot;Therefore confess your sins to one another and pray for one another, that you may be healed.&quot;&#10;— James 5:16"
                           FontSize="13" FontAttributes="Italic" TextColor="#D4F1DE"
                           Margin="0,8,24,0" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <RefreshView Grid.Row="1" x:Name="PrayerRefreshView">
            <Grid>
                <CollectionView x:Name="PrayerCollectionView"
                                SelectionMode="None"
                                RemainingItemsThreshold="2"
                                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="14" Padding="16,16,16,8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" Padding="14,11" BackgroundColor="{StaticResource SoftMint}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 16">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="🙏" FontSize="18" TextColor="{StaticResource BrandGreen}" />
                                        <Label Text="Prayer Wall" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandGreen}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Button Grid.Column="1" Text="My Requests" Clicked="OnMyRequestsClicked"
                                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                                        FontSize="13" Padding="8,0" />
                                <Button Grid.Column="2" Text="Community" Clicked="OnCommunityClicked"
                                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                                        FontSize="13" Padding="8,0" />
                            </Grid>

                            <Button x:Name="AddPrayerButton" Text="＋  Add Prayer Request"
                                    BackgroundColor="{StaticResource BrandGreen}" TextColor="White"
                                    CornerRadius="18" HeightRequest="54" FontSize="16"
                                    FontAttributes="Bold" Clicked="OnAddPrayerClicked"
                                    SemanticProperties.Description="Open the prayer request form" />
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="32,42" Spacing="12"
                                             HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="🙏" FontSize="42" HorizontalOptions="Center" />
                            <Label Text="No prayer requests yet" FontSize="22"
                                   FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Text="Be the first to share a prayer request with the community."
                                   FontSize="15" TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="＋  Add Prayer Request"                             BackgroundColor="{StaticResource BrandGreen}"
                                    TextColor="White" CornerRadius="16"
                                    Clicked="OnAddPrayerClicked" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,6" Padding="20" MinimumHeightRequest="290"
                                    BackgroundColor="{Binding CardBackgroundColor}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 22">
                                <Border.Shadow>
                                    <Shadow Brush="#173B28" Offset="0,4" Radius="14" Opacity="0.11" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                                BackgroundColor="White" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 21">
                                            <Label Text="👤" FontSize="20"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding AuthorDisplayName}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="(Anonymous)" IsVisible="{Binding IsAnonymous}"
                                                   FontSize="12" TextColor="#718096" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="⋮" FontSize="24"
                                               TextColor="#718096" VerticalOptions="Start" />
                                    </Grid>

                                    <Border Padding="9,6" BackgroundColor="#EEF8F1"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding ReachLabel}" FontAttributes="Bold"
                                               FontSize="11" TextColor="#18723B" />
                                    </Border>

                                    <Label Text="{Binding Content}" FontSize="16"
                                           LineBreakMode="WordWrap" TextColor="#1F2937"
                                           LineHeight="1.15" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Text="{Binding RelativeCreatedAt}"
                                               FontSize="12" TextColor="#718096"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="🙏  I PRAY"
                                                Padding="14,9" BackgroundColor="White"
                                                TextColor="{StaticResource BrandGreen}" CornerRadius="16"
                                                FontAttributes="Bold" FontSize="13"
                                                CommandParameter="{Binding PrayerId}"
                                                Clicked="OnPrayClicked"
                                                SemanticProperties.Description="Pray for this request">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsPrayed}" Value="True">
                                                    <Setter Property="Text" Value="🙏  I PRAYED" />
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>
                                    <Label Text="{Binding PrayerCount, StringFormat='🙏  {0} people prayed'}"
                                           FontSize="12" TextColor="#718096" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout x:Name="PrayerLoadingIndicator" IsVisible="False"
                                     BackgroundColor="#F4F8F5" HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="8">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource BrandGreen}" />
                    <Label Text="Loading prayer requests..." TextColor="#475569" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="PrayerErrorState" IsVisible="False"
                                     BackgroundColor="#F4F8F5" HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="10" Padding="28">
                    <Label x:Name="PrayerErrorMessage" Text="Couldn't load prayer requests."
                           TextColor="#991B1B" HorizontalTextAlignment="Center" />
                    <Button Text="Try Again" Clicked="OnRetryFetchClicked"
                            BackgroundColor="{StaticResource BrandGreen}" TextColor="White" CornerRadius="16" />
                </VerticalStackLayout>
            </Grid>
        </RefreshView>

        <Grid x:Name="IntroOverlay" IsVisible="False" BackgroundColor="#0F172A"
              Opacity="0.6" Padding="0">
            <Border Margin="28" BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 28" Padding="24" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="🙏" FontSize="42" HorizontalOptions="Center" />
                    <Label Text="WELCOME TO THE PRAYER COMMUNITY" FontAttributes="Bold"
                           FontSize="24" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                    <Label Text="You don't have to pray alone. Share a prayer request and let members of the USCF family stand with you."
                           FontSize="15" TextColor="#475569" HorizontalTextAlignment="Center" />
                    <Button Text="GOT IT" BackgroundColor="#009E2C" TextColor="White"
                            CornerRadius="16" Clicked="OnIntroDismissed" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
