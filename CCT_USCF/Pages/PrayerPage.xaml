<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.PrayerPage"
    Title="Prayer"
    BackgroundColor="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,18" BackgroundColor="#F0FDF4" StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <Label Text="🙏" FontSize="34" HorizontalOptions="Center" />
                <Label Text="PRAYER COMMUNITY" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                <Label Text="Let us pray for one another." FontSize="15" TextColor="#475569" HorizontalOptions="Center" />

                <Button
                    x:Name="AddPrayerButton"
                    Text="＋ ADD PRAYER"
                    BackgroundColor="#009E2C"
                    TextColor="White"
                    CornerRadius="18"
                    HeightRequest="52"
                    Clicked="OnAddPrayerClicked" />
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1" x:Name="PrayerRefreshView">
            <Grid>
            <CollectionView x:Name="PrayerCollectionView" SelectionMode="None" Margin="0,12,0,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="🙏" FontSize="42" HorizontalOptions="Center" />
                        <Label Text="No prayer requests yet." FontSize="22" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                        <Label Text="Be the first to share a prayer with the USCF family." FontSize="15" TextColor="#475569" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Button Text="＋ ADD PRAYER" BackgroundColor="#009E2C" TextColor="White" Clicked="OnAddPrayerClicked" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="16,6" Padding="18" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                            <Border.Shadow>
                                <Shadow Brush="#1F2937" Offset="0,4" Radius="10" Opacity="0.08" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="👤" FontSize="18" />
                                    <Label Text="{Binding AuthorDisplayName}" FontAttributes="Bold" FontSize="16" TextColor="#0F172A" />
                                    <Label Text="(Anonymous)" IsVisible="{Binding IsAnonymous}" FontSize="12" TextColor="#64748B" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding Content}" FontSize="16" LineBreakMode="WordWrap" TextColor="#1E293B" />

                                <Border Padding="8,6" BackgroundColor="#ECFDF5" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Start">
                                    <Label Text="{Binding CategoryLabel}" FontAttributes="Bold" FontSize="12" TextColor="#166534" />
                                </Border>

                                <Label Text="{Binding ReachLabel}" FontSize="12" TextColor="#64748B" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding StatusLabelText}" FontSize="12" TextColor="#166534" VerticalOptions="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Text="I PRAY 🙏"
                                        Padding="10,8"
                                        BackgroundColor="#E8F5E9"
                                        TextColor="#166534"
                                        CornerRadius="12"
                                        FontAttributes="Bold"
                                        CommandParameter="{Binding PrayerId}"
                                        Clicked="OnPrayClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout x:Name="PrayerLoadingIndicator" IsVisible="False" BackgroundColor="#F8FAFC" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="#009E2C" />
                <Label Text="Loading prayer requests..." TextColor="#475569" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="PrayerErrorState" IsVisible="False" BackgroundColor="#F8FAFC" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <Label x:Name="PrayerErrorMessage" Text="Unable to load prayer requests." TextColor="#991B1B" HorizontalTextAlignment="Center" />
                <Button Text="Try Again" Clicked="OnRetryFetchClicked" BackgroundColor="#009E2C" TextColor="White" />
            </VerticalStackLayout>
            </Grid>
        </RefreshView>

        <Grid x:Name="IntroOverlay" IsVisible="False" BackgroundColor="#0F172A" Opacity="0.6" Padding="0">
            <Border Margin="28" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="24" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="🙏" FontSize="42" HorizontalOptions="Center" />
                    <Label Text="WELCOME TO THE PRAYER COMMUNITY" FontAttributes="Bold" FontSize="24" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                    <Label Text="You don't have to pray alone. Share a prayer request and let members of the USCF family stand with you." FontSize="15" TextColor="#475569" HorizontalTextAlignment="Center" />

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🙏" FontSize="18" />
                        <Label Text="Add Prayer" FontAttributes="Bold" TextColor="#0F172A" />
                    </HorizontalStackLayout>
                    <Label Text="Share your request." FontSize="14" TextColor="#475569" />

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="❤️" FontSize="18" />
                        <Label Text="I Prayed" FontAttributes="Bold" TextColor="#0F172A" />
                    </HorizontalStackLayout>
                    <Label Text="Let someone know you prayed." FontSize="14" TextColor="#475569" />

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🌍" FontSize="18" />
                        <Label Text="Prayer Wall" FontAttributes="Bold" TextColor="#0F172A" />
                    </HorizontalStackLayout>
                    <Label Text="Discover prayer requests from the USCF family." FontSize="14" TextColor="#475569" />

                    <Button
                        Text="GOT IT"
                        BackgroundColor="#009E2C"
                        TextColor="White"
                        CornerRadius="16"
                        Clicked="OnIntroDismissed" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>