<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.PrayerPage"
    Title="Prayer"
    BackgroundColor="#F8FAFC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="🙏 Prayer Center"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1E40AF" />

            <Label
                Text="Share your prayer request and pray for others."
                FontSize="17"
                TextColor="#64748B" />

            <Border
                BackgroundColor="White"
                Padding="20"
                StrokeThickness="0">

                <VerticalStackLayout
                    Spacing="15">

                    <Label
                        Text="Submit a Prayer Request"
                        FontSize="21"
                        FontAttributes="Bold" />

                    <Entry
                        Placeholder="Prayer title" />

                    <Editor
                        Placeholder="Write your prayer request..."
                        HeightRequest="150" />

                    <Button
                        Text="🙏 Submit Prayer Request" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Prayer Wall"
                FontSize="24"
                FontAttributes="Bold" />

            <Border
                BackgroundColor="White"
                Padding="20"
                StrokeThickness="0">

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Please pray for our church, families and community."
                        FontSize="17" />

                    <Button
                        Text="🙏 I Prayed"
                        HorizontalOptions="Start" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>