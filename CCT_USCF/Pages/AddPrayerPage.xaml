<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.AddPrayerPage"
    Title="{DynamicResource AppText_Prayer_AddTitle}"
    BackgroundColor="{DynamicResource AppPageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="🙏" FontSize="48" HorizontalOptions="Center" />
            <Label Text="{DynamicResource AppText_Prayer_RequestTitle}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
            <Label Text="{DynamicResource AppText_Prayer_HowCanWePray}" FontSize="16" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{DynamicResource AppText_Prayer_ShareHeart}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Editor x:Name="PrayerEditor" Placeholder="{DynamicResource AppText_Prayer_WriteRequest}" MinimumHeightRequest="120" AutoSize="TextChanges" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource SurfaceDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{DynamicResource AppText_Prayer_Category}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="CategoryPicker" Title="{DynamicResource AppText_Prayer_SelectCategory}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{DynamicResource AppText_Prayer_WhoShouldPray}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="ReachPicker" Title="{DynamicResource AppText_Prayer_SelectReach}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{DynamicResource AppText_Prayer_WhoCanSeePrayer}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="VisibilityPicker" Title="{DynamicResource AppText_Prayer_Visibility}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{DynamicResource AppText_Prayer_WhoCanSeeName}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="NameVisibilityPicker" Title="{DynamicResource AppText_Prayer_AuthorVisibility}" />
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="SubmitPrayerButton"
                Text="{DynamicResource AppText_Prayer_Submit}"
                BackgroundColor="{StaticResource BrandGreen}"
                TextColor="White"
                CornerRadius="18"
                MinimumHeightRequest="56"
                Clicked="OnSubmitPrayerClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
