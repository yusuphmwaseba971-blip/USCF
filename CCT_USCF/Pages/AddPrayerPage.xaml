<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.AddPrayerPage"
    Title="Add Prayer"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="🙏" FontSize="48" HorizontalOptions="Center" />
            <Label Text="Prayer Request" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
            <Label Text="How can we pray for you?" FontSize="16" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Share what's on your heart." FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Editor x:Name="PrayerEditor" Placeholder="Write your prayer request here..." MinimumHeightRequest="120" AutoSize="TextChanges" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource SurfaceDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Prayer Category" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="CategoryPicker" Title="Select a category" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Who should pray for you?" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="ReachPicker" Title="Select prayer reach" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Who can see the prayer?" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="VisibilityPicker" Title="Prayer visibility" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Who can see your name?" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Picker x:Name="NameVisibilityPicker" Title="Author visibility" />
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="SubmitPrayerButton"
                Text="🙏 ADD PRAYER"
                BackgroundColor="{StaticResource BrandGreen}"
                TextColor="White"
                CornerRadius="18"
                MinimumHeightRequest="56"
                Clicked="OnSubmitPrayerClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
