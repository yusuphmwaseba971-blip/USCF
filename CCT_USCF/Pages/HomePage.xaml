<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CCT_USCF.Pages.HomePage"
             Title="{DynamicResource AppText_Home_Title}"
             BackgroundColor="{DynamicResource AppPageBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,14,18,34" Spacing="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource SoftMint}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Label Text="☰" FontSize="22" TextColor="{StaticResource BrandGreen}"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OpenSettings" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="USCF" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                        <Label Text="{DynamicResource AppText_Home_ChurchHeadquarters}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}"
                            Stroke="#DCEBE0" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                        <Grid>
                            <Label Text="◉" FontSize="21" TextColor="{StaticResource BrandGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OpenNotifications" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Border x:Name="UnreadBadge" IsVisible="False" WidthRequest="18" HeightRequest="18"
                                    BackgroundColor="#D92D20" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                    HorizontalOptions="End" VerticalOptions="Start">
                                <Label x:Name="UnreadCountLabel" TextColor="White" FontSize="10"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Padding="20,22" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#075E36" Offset="0" />
                            <GradientStop Color="#009E2C" Offset="0.68" />
                            <GradientStop Color="#35B96A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenProfile" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="✝" FontSize="120" TextColor="White" Opacity="0.07"
                               HorizontalOptions="End" VerticalOptions="End" TranslationY="26" />
                        <VerticalStackLayout Spacing="5">
                            <Label x:Name="GreetingLabel" Text="{DynamicResource AppText_Home_WelcomeBack}" FontSize="11"
                                   FontAttributes="Bold" TextColor="#C9F1D5" />
                            <Label x:Name="UserNameLabel" Text="{DynamicResource AppText_Home_CommunityActive}"
                                   FontSize="24" FontAttributes="Bold" TextColor="White" />
                            <Label x:Name="ChurchContextLabel" Text="{DynamicResource AppText_Home_LoadingChurch}"
                                   FontSize="13" TextColor="#E3F8E9" />
                            <Label Text="{DynamicResource AppText_Home_ViewProfile}" FontSize="12" TextColor="#C9F1D5"
                                   Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource AppText_Home_TodayInUscf}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{DynamicResource AppText_Home_ViewActivities}" Grid.Column="1" FontSize="12"
                               TextColor="{StaticResource BrandGreen}" VerticalOptions="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OpenNotifications" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Padding="13" BackgroundColor="{AppThemeBinding Light={StaticResource AccentPurpleTint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenNotifications" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="!" FontSize="22" TextColor="{StaticResource AccentPurple}" />
                                <Label x:Name="AnnouncementsCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="#38216B" />
                                <Label Text="{DynamicResource AppText_Home_Announcements}" FontSize="11" TextColor="#75658F" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="13" BackgroundColor="{AppThemeBinding Light={StaticResource AccentBlueTint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenPrayer" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="♡" FontSize="23" TextColor="{StaticResource AccentBlue}" />
                                <Label x:Name="PrayerCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="#123B73" />
                                <Label Text="{DynamicResource AppText_Home_PrayerRequests}" FontSize="11" TextColor="#54708B" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Padding="13" BackgroundColor="{AppThemeBinding Light={StaticResource SoftMint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenCommunity" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="♧" FontSize="23" TextColor="{StaticResource BrandGreen}" />
                                <Label x:Name="ActivityCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                                <Label Text="{DynamicResource AppText_Home_CommunityActivity}" FontSize="11" TextColor="#537160" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Padding="13" BackgroundColor="{AppThemeBinding Light={StaticResource AccentGoldTint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenEvents" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="□" FontSize="23" TextColor="{StaticResource AccentGold}" />
                                <Label x:Name="EventsCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="#684400" />
                                <Label Text="{DynamicResource AppText_Home_ChurchActivity}" FontSize="11" TextColor="#8A7045" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="2" Padding="13" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenSermons" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="▶" FontSize="20" TextColor="{StaticResource AccentBlue}" />
                                <Label Text="—" FontSize="24" FontAttributes="Bold" TextColor="#273B73" />
                                <Label Text="{DynamicResource AppText_Home_NewSermon}" FontSize="11" TextColor="#63739B" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <Border Padding="18" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <Border.Shadow><Shadow Brush="#173B28" Offset="0,3" Radius="12" Opacity="0.10" /></Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{DynamicResource AppText_Home_MyChurch}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{DynamicResource AppText_Home_Open}" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenChurch" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Label x:Name="MyChurchLabel" Text="{DynamicResource AppText_Home_OrganizationPlaceholder}" FontSize="18"
                               FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                        <Label x:Name="MyChurchMetaLabel" Text="{DynamicResource AppText_Home_MemberCountUnavailable}"
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Button Text="{DynamicResource AppText_Home_OpenMyChurch}" Clicked="OpenChurchButton" BackgroundColor="{StaticResource SoftMint}"
                                TextColor="{StaticResource BrandGreen}" CornerRadius="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" BackgroundColor="{AppThemeBinding Light={StaticResource SoftMint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenNotifications" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="7">
                        <Label Text="{DynamicResource AppText_Home_OfficialUpdate}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                        <Label x:Name="LatestAnnouncementTitleLabel" Text="{DynamicResource AppText_Home_NoAnnouncements}" FontSize="20"
                               FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                        <Label x:Name="LatestAnnouncementMessageLabel" Text="{DynamicResource AppText_Home_CaughtUp}"
                               FontSize="13" TextColor="#537160" LineBreakMode="WordWrap" />
                        <Label x:Name="LatestAnnouncementMetaLabel" Text="{DynamicResource AppText_Home_ViewAnnouncements}" FontSize="12"
                               TextColor="{StaticResource BrandGreen}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource AppText_Home_YourGroups}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{DynamicResource AppText_Home_SeeAll}" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenChurch" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource AccentGoldTint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenChurch" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light={StaticResource AccentGoldTint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                <Label Text="♧" FontSize="29" TextColor="#A66A00" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{DynamicResource AppText_Home_Groups}" FontSize="17" FontAttributes="Bold" TextColor="#684400" />
                                <Label Text="{DynamicResource AppText_Home_ChooseGroupLevel}" FontSize="12" TextColor="#8A7045" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#A66A00" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Padding="18" BackgroundColor="{AppThemeBinding Light={StaticResource AccentBlueTint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenPrayer" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{DynamicResource AppText_Home_PrayWithCommunity}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AccentBlue}" />
                        <Label x:Name="PrayerPreviewLabel" Text="{DynamicResource AppText_Home_PrayerPreview}"
                               FontSize="16" FontAttributes="Bold" TextColor="#123B73" LineBreakMode="WordWrap" />
                        <Button Text="{DynamicResource AppText_Home_OpenPrayerWall}" Clicked="OpenPrayerButton" BackgroundColor="Transparent"
                                TextColor="{StaticResource AccentBlue}" HorizontalOptions="Start" Padding="0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource AppText_Home_TodayWord}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{DynamicResource AppText_Home_ReadPassage}" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenBible" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Padding="18" BackgroundColor="{AppThemeBinding Light={StaticResource AccentBlueTint}, Dark={StaticResource SurfaceDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenBible" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{DynamicResource AppText_Home_TodayWordUpper}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AccentBlue}" />
                            <Label Text="Your word is a lamp to my feet and a light to my path."
                                   FontSize="18" FontAttributes="Bold" TextColor="#17315F" />
                            <Label Text="Psalm 119:105" FontSize="12" TextColor="#63739B" />
                        </VerticalStackLayout>
                    </Border>
                    <StackLayout x:Name="BibleFeedStack" Spacing="10" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource AppText_Home_UscfCommunity}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{DynamicResource AppText_Home_SeeAll}" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenCommunity" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <StackLayout x:Name="NationalFeedStack" Spacing="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource AppText_Home_PlusPosts}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{DynamicResource AppText_Home_Refresh}" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="RefreshCctPosts" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label x:Name="CctPostsStateLabel" Text="{DynamicResource AppText_Home_LoadingPosts}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <VerticalStackLayout x:Name="CctPostsStack" Spacing="10" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{DynamicResource AppText_Home_UpcomingActivity}" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{DynamicResource AppText_Home_SeeAll}" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenEvents" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label x:Name="EventsPreviewLabel" Text="{DynamicResource AppText_Home_NoUpcomingActivity}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="ShareServeOverlay" Grid.Row="0" IsVisible="False" BackgroundColor="#66000000"
              Padding="14,0,14,18" VerticalOptions="Fill">
            <Border VerticalOptions="End" BackgroundColor="{StaticResource SurfaceWhite}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="20,18">
                <Border.Shadow>
                    <Shadow Brush="#173B28" Offset="0,-4" Radius="18" Opacity="0.24" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{DynamicResource AppText_Home_ShareServe}" FontSize="23" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDeepGreen}" />
                            <Label Text="{DynamicResource AppText_Home_ContributePrompt}" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×" Clicked="CloseShareAndServe"
                                BackgroundColor="{StaticResource SoftMint}" TextColor="{StaticResource BrandGreen}"
                                WidthRequest="44" HeightRequest="44" CornerRadius="22" FontSize="24"
                                SemanticProperties.Description="{DynamicResource AppText_Home_CloseShareServe}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="10" RowSpacing="10">
                        <Button Text="{DynamicResource AppText_Home_Scripture}" Clicked="OpenScriptureComposer" BackgroundColor="#EEF5FF" TextColor="#17315F" />
                        <Button Grid.Column="1" Text="{DynamicResource AppText_Home_Prayer}" Clicked="OpenPrayerFromShare" BackgroundColor="{AppThemeBinding Light={StaticResource SoftMint}, Dark={StaticResource SurfaceDark}}" TextColor="{StaticResource BrandDeepGreen}" />
                        <Button Grid.Row="1" Text="{DynamicResource AppText_Home_Encouragement}" Clicked="OpenEncouragementComposer" BackgroundColor="{AppThemeBinding Light={StaticResource AccentPurpleTint}, Dark={StaticResource SurfaceDark}}" TextColor="#38216B" />
                        <Button Grid.Row="1" Grid.Column="1" Text="{DynamicResource AppText_Home_Notice}" Clicked="OpenNoticeComposer" BackgroundColor="{AppThemeBinding Light={StaticResource AccentGoldTint}, Dark={StaticResource SurfaceDark}}" TextColor="#684400" />
                        <Button Grid.Row="2" Text="{DynamicResource AppText_Home_Worship}" Clicked="OpenWorshipComposer" BackgroundColor="{AppThemeBinding Light={StaticResource AccentBlueTint}, Dark={StaticResource SurfaceDark}}" TextColor="#123B73" />
                        <Button Grid.Row="2" Grid.Column="1" Text="{DynamicResource AppText_Home_Event}" Clicked="OpenEventComposer" BackgroundColor="{AppThemeBinding Light={StaticResource SoftMint}, Dark={StaticResource SurfaceDark}}" TextColor="{StaticResource BrandDeepGreen}" />
                    </Grid>
                    <Button Text="{DynamicResource AppText_Common_Close}" Clicked="CloseShareAndServe" BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandGreen}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="0" x:Name="ShortcutPanel" IsVisible="False" VerticalOptions="End" HorizontalOptions="End"
              Margin="0,0,18,24" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <Button Text="{DynamicResource AppText_Home_ShortcutAnnouncements}" Clicked="OpenNotificationsButton" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" TextColor="{StaticResource TextPrimary}"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="1" Text="{DynamicResource AppText_Home_ShortcutEvents}" Clicked="OpenEventsButton" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" TextColor="{StaticResource TextPrimary}"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="2" Text="{DynamicResource AppText_Home_ShortcutSermons}" Clicked="OpenSermonsButton" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" TextColor="{StaticResource TextPrimary}"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="3" Text="Discover CCT-USCF" Clicked="OpenAboutCctUsfcButton" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" TextColor="{StaticResource TextPrimary}"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="4" Text="{DynamicResource AppText_Home_ShortcutGiving}" Clicked="OpenGivingButton" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWhite}, Dark={StaticResource SurfaceDark}}" TextColor="{StaticResource TextPrimary}"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
        </Grid>
        <Button Grid.Row="0" x:Name="ShortcutButton" Text="＋" Clicked="ToggleShortcuts"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,18,18"
                WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="0" FontSize="30"
                BackgroundColor="{StaticResource BrandGreen}" TextColor="White"
                SemanticProperties.Description="{DynamicResource AppText_Home_OpenShortcuts}" />
    </Grid>
</ContentPage>
