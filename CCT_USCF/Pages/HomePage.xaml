<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CCT_USCF.Pages.HomePage"
             Title="Home"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,14,18,34" Spacing="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource SoftMint}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Label Text="☰" FontSize="22" TextColor="{StaticResource BrandGreen}"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OpenSettings" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="USCF" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                        <Label Text="My church headquarters" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="White"
                            Stroke="#DCEBE0" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                        <Grid>
                            <Label Text="◉" FontSize="21" TextColor="{StaticResource BrandGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OpenNotifications" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Border x:Name="UnreadBadge" IsVisible="False" WidthRequest="18" HeightRequest="18"
                                    BackgroundColor="#D92D20" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                    HorizontalOptions="End" VerticalOptions="Start">
                                <Label x:Name="UnreadCountLabel" TextColor="White" FontSize="10"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Padding="20,22" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#075E36" Offset="0" />
                            <GradientStop Color="#009E2C" Offset="0.68" />
                            <GradientStop Color="#35B96A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OpenProfile" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="✝" FontSize="120" TextColor="White" Opacity="0.07"
                               HorizontalOptions="End" VerticalOptions="End" TranslationY="26" />
                        <VerticalStackLayout Spacing="5">
                            <Label x:Name="GreetingLabel" Text="WELCOME BACK 👋" FontSize="11"
                                   FontAttributes="Bold" TextColor="#C9F1D5" />
                            <Label x:Name="UserNameLabel" Text="Your USCF community is active today."
                                   FontSize="24" FontAttributes="Bold" TextColor="White" />
                            <Label x:Name="ChurchContextLabel" Text="Your church context is loading..."
                                   FontSize="13" TextColor="#E3F8E9" />
                            <Label Text="View your profile  ›" FontSize="12" TextColor="#C9F1D5"
                                   Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Today in USCF" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="View all activities  ›" Grid.Column="1" FontSize="12"
                               TextColor="{StaticResource BrandGreen}" VerticalOptions="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OpenNotifications" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Padding="13" BackgroundColor="#F3EDFF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenNotifications" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="!" FontSize="22" TextColor="{StaticResource AccentPurple}" />
                                <Label x:Name="AnnouncementsCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="#38216B" />
                                <Label Text="Announcements" FontSize="11" TextColor="#75658F" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="13" BackgroundColor="#EAF5FF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenPrayer" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="♡" FontSize="23" TextColor="{StaticResource AccentBlue}" />
                                <Label x:Name="PrayerCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="#123B73" />
                                <Label Text="Prayer Requests" FontSize="11" TextColor="#54708B" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Padding="13" BackgroundColor="#EAF7EE" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenCommunity" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="♧" FontSize="23" TextColor="{StaticResource BrandGreen}" />
                                <Label x:Name="ActivityCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                                <Label Text="Community activity" FontSize="11" TextColor="#537160" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Padding="13" BackgroundColor="#FFF8E7" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenEvents" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="□" FontSize="23" TextColor="{StaticResource AccentGold}" />
                                <Label x:Name="EventsCountLabel" Text="—" FontSize="24" FontAttributes="Bold" TextColor="#684400" />
                                <Label Text="Church activity" FontSize="11" TextColor="#8A7045" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Row="2" Padding="13" BackgroundColor="#EEF2FF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenSermons" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="▶" FontSize="20" TextColor="{StaticResource AccentBlue}" />
                                <Label Text="—" FontSize="24" FontAttributes="Bold" TextColor="#273B73" />
                                <Label Text="New sermon" FontSize="11" TextColor="#63739B" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <Border Padding="18" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <Border.Shadow><Shadow Brush="#173B28" Offset="0,3" Radius="12" Opacity="0.10" /></Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="My Church" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Open  ›" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenChurch" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Label x:Name="MyChurchLabel" Text="Your organization will appear here." FontSize="18"
                               FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                        <Label x:Name="MyChurchMetaLabel" Text="Member count is not available from the current services."
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        <Button Text="Open My Church" Clicked="OpenChurchButton" BackgroundColor="{StaticResource SoftMint}"
                                TextColor="{StaticResource BrandGreen}" CornerRadius="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" BackgroundColor="#EAF7EE" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenNotifications" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="7">
                        <Label Text="OFFICIAL USCF UPDATE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                        <Label x:Name="LatestAnnouncementTitleLabel" Text="No new announcements" FontSize="20"
                               FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                        <Label x:Name="LatestAnnouncementMessageLabel" Text="You're all caught up."
                               FontSize="13" TextColor="#537160" MaxLines="3" />
                        <Label x:Name="LatestAnnouncementMetaLabel" Text="View announcements  ›" FontSize="12"
                               TextColor="{StaticResource BrandGreen}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Your Church Groups" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="See all  ›" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenChurch" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Padding="16" BackgroundColor="#FFF8E7" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenChurch" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFEDB7" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                <Label Text="♧" FontSize="29" TextColor="#A66A00" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Church Groups" FontSize="17" FontAttributes="Bold" TextColor="#684400" />
                                <Label Text="Choose a level to view available groups." FontSize="12" TextColor="#8A7045" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#A66A00" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Padding="18" BackgroundColor="#EAF5FF" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenPrayer" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PRAY WITH YOUR COMMUNITY" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AccentBlue}" />
                        <Label x:Name="PrayerPreviewLabel" Text="Prayer requests will appear here when available."
                               FontSize="16" FontAttributes="Bold" TextColor="#123B73" MaxLines="3" />
                        <Button Text="Open prayer wall  ›" Clicked="OpenPrayerButton" BackgroundColor="Transparent"
                                TextColor="{StaticResource AccentBlue}" HorizontalOptions="Start" Padding="0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Today's Word" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Read passage  ›" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenBible" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border Padding="18" BackgroundColor="#EEF5FF" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenBible" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="TODAY'S WORD" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AccentBlue}" />
                            <Label Text="Your word is a lamp to my feet and a light to my path."
                                   FontSize="18" FontAttributes="Bold" TextColor="#17315F" />
                            <Label Text="Psalm 119:105" FontSize="12" TextColor="#63739B" />
                        </VerticalStackLayout>
                    </Border>
                    <StackLayout x:Name="BibleFeedStack" Spacing="10" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="USCF Community" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="See all  ›" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenCommunity" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <StackLayout x:Name="NationalFeedStack" Spacing="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Community Blessings" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Share &amp; Serve  ›" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OpenShareAndServe" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label x:Name="CommunityBlessingsStateLabel"
                           Text="Loading contributions..." FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <VerticalStackLayout x:Name="CommunityBlessingsStack" Spacing="10" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Upcoming Church Activity" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="See all  ›" Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandGreen}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OpenEvents" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Label x:Name="EventsPreviewLabel" Text="No upcoming activity available." FontSize="14" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="ShareServeOverlay" Grid.Row="0" IsVisible="False" BackgroundColor="#66000000"
              Padding="14,0,14,18" VerticalOptions="Fill">
            <Border VerticalOptions="End" BackgroundColor="{StaticResource SurfaceWhite}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="20,18">
                <Border.Shadow>
                    <Shadow Brush="#173B28" Offset="0,-4" Radius="18" Opacity="0.24" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="✨ Share &amp; Serve" FontSize="23" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDeepGreen}" />
                            <Label Text="What would you like to contribute?" FontSize="13"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="×" Clicked="CloseShareAndServe"
                                BackgroundColor="{StaticResource SoftMint}" TextColor="{StaticResource BrandGreen}"
                                WidthRequest="44" HeightRequest="44" CornerRadius="22" FontSize="24"
                                SemanticProperties.Description="Close Share and Serve menu" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="10" RowSpacing="10">
                        <Button Text="📖  Scripture" Clicked="OpenScriptureComposer" BackgroundColor="#EEF5FF" TextColor="#17315F" />
                        <Button Grid.Column="1" Text="🙏  Prayer" Clicked="OpenPrayerFromShare" BackgroundColor="#EAF7EE" TextColor="{StaticResource BrandDeepGreen}" />
                        <Button Grid.Row="1" Text="💬  Encouragement" Clicked="OpenEncouragementComposer" BackgroundColor="#F3EDFF" TextColor="#38216B" />
                        <Button Grid.Row="1" Grid.Column="1" Text="📢  Notice" Clicked="OpenNoticeComposer" BackgroundColor="#FFF8E7" TextColor="#684400" />
                        <Button Grid.Row="2" Text="🎵  Worship" Clicked="OpenWorshipComposer" BackgroundColor="#EAF5FF" TextColor="#123B73" />
                        <Button Grid.Row="2" Grid.Column="1" Text="📅  Event" Clicked="OpenEventComposer" BackgroundColor="#EAF7EE" TextColor="{StaticResource BrandDeepGreen}" />
                        <Button Grid.Row="3" Grid.ColumnSpan="2" Text="📚  Resource" Clicked="OpenResourceComposer" BackgroundColor="#F2F4F7" TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <Button Text="Close" Clicked="CloseShareAndServe" BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandGreen}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="0" x:Name="ShortcutPanel" IsVisible="False" VerticalOptions="End" HorizontalOptions="End"
              Margin="0,0,18,24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
            <Button Text="Announcements  !" Clicked="OpenNotificationsButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="1" Text="Events  □" Clicked="OpenEventsButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="2" Text="Sermons  ▶" Clicked="OpenSermonsButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="3" Text="Giving  ＋" Clicked="OpenGivingButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
        </Grid>
        <Button Grid.Row="0" x:Name="ShortcutButton" Text="＋" Clicked="ToggleShortcuts"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,18,18"
                WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="0" FontSize="30"
                BackgroundColor="{StaticResource BrandGreen}" TextColor="White"
                SemanticProperties.Description="Open quick shortcuts" />
    </Grid>
</ContentPage>
