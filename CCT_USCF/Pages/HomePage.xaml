<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.HomePage"
    Title="Home"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,14,18,28" Spacing="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource SoftMint}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 14">
                        <Label Text="☰" FontSize="22" TextColor="{StaticResource BrandGreen}"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OpenSettings" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="USCF" FontSize="25" FontAttributes="Bold" TextColor="{StaticResource BrandDeepGreen}" />
                        <Label Text="Christian Community &amp; Fellowship" FontSize="11" TextColor="#688074" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" BackgroundColor="White"
                            Stroke="#DCEBE0" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                        <Grid>
                            <Label Text="◉" FontSize="21" TextColor="#087A30"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OpenNotifications" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Border x:Name="UnreadBadge" IsVisible="False" WidthRequest="18" HeightRequest="18"
                                    BackgroundColor="#D92D20" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                    HorizontalOptions="End" VerticalOptions="Start">
                                <Label x:Name="UnreadCountLabel" TextColor="White" FontSize="10"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Padding="16" BackgroundColor="{StaticResource BrandDeepGreen}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 22">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OpenWelcome" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="WELCOME TO USCF" FontSize="11" FontAttributes="Bold" TextColor="#BDEBCB" />
                            <Label Text="Grow in faith." FontSize="22" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Connect, serve and walk together in Christ." FontSize="12" TextColor="#E3F8E9" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource SoftMint}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 22">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OpenBible" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="TODAY'S WORD" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                            <Label Text="Your word is a lamp to my feet" FontSize="16" FontAttributes="Bold"
                                   TextColor="#123B25" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="Psalm 119:105  ›" FontSize="12" TextColor="#537160" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Featured" FontSize="21" FontAttributes="Bold" TextColor="#173323" />
                        <Label Grid.Column="1" Text="Explore" FontSize="13" TextColor="#087A30"
                               VerticalOptions="End" />
                    </Grid>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="108" Padding="13" BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenBible" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource SoftMint}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                        <Label Text="▤" FontSize="25" TextColor="{StaticResource BrandGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Bible" FontAttributes="Bold" TextColor="#173323" />
                                    <Label Text="Read &amp; reflect" FontSize="11" TextColor="#718178" />
                                </VerticalStackLayout>
                            </Border>
                            <Border WidthRequest="108" Padding="13" BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenPrayer" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E4F6E9"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                        <Label Text="♡" FontSize="28" TextColor="{StaticResource BrandGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Prayer" FontAttributes="Bold" TextColor="#173323" />
                                    <Label Text="Share a request" FontSize="11" TextColor="#718178" />
                                </VerticalStackLayout>
                            </Border>
                            <Border WidthRequest="108" Padding="13" BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenCommunity" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E4F6E9"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                        <Label Text="♧" FontSize="28" TextColor="#087A30" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Community" FontAttributes="Bold" TextColor="#173323" />
                                    <Label Text="Connect together" FontSize="11" TextColor="#718178" />
                                </VerticalStackLayout>
                            </Border>
                            <Border WidthRequest="108" Padding="13" BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenProfile" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E4F6E9"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                        <Label Text="●" FontSize="25" TextColor="#087A30" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Profile" FontAttributes="Bold" TextColor="#173323" />
                                    <Label Text="Your account" FontSize="11" TextColor="#718178" />
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Bible Readings" FontSize="20" FontAttributes="Bold" TextColor="#173323" />
                    <StackLayout x:Name="BibleFeedStack" Spacing="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Full Community" FontSize="20" FontAttributes="Bold" TextColor="#173323" />
                        <Label Grid.Column="1" Text="See all  ›" FontSize="13" TextColor="#087A30" />
                    </Grid>
                    <StackLayout x:Name="NationalFeedStack" Spacing="12" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Quick Actions" FontSize="20" FontAttributes="Bold" TextColor="#173323" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Padding="14" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenSermons" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="▶" FontSize="25" TextColor="{StaticResource AccentBlue}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"><Label Text="Sermons" FontAttributes="Bold" /><Label Text="Watch messages" FontSize="11" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Padding="14" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenGiving" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="＋" FontSize="25" TextColor="{StaticResource AccentGold}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"><Label Text="Giving" FontAttributes="Bold" /><Label Text="Support ministry" FontSize="11" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Padding="14" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenEvents" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="□" FontSize="25" TextColor="{StaticResource AccentBlue}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"><Label Text="Events" FontAttributes="Bold" /><Label Text="Stay involved" FontSize="11" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Padding="14" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OpenNotifications" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="!" FontSize="25" TextColor="{StaticResource AccentPurple}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"><Label Text="Announcements" FontAttributes="Bold" /><Label Text="What's new" FontSize="11" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="0" x:Name="ShortcutPanel" IsVisible="False" VerticalOptions="End" HorizontalOptions="End"
              Margin="0,0,18,24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
            <Button Text="Announcements  !" Clicked="OpenNotificationsButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="1" Text="Events  □" Clicked="OpenEventsButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="2" Text="Sermons  ▶" Clicked="OpenSermonsButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
            <Button Grid.Row="3" Text="Giving  ＋" Clicked="OpenGivingButton" BackgroundColor="White" TextColor="#173323"
                    CornerRadius="20" Padding="14,8" FontSize="12" />
        </Grid>

        <Button Grid.Row="0" x:Name="ShortcutButton" Text="＋" Clicked="ToggleShortcuts"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,18,18"
                WidthRequest="60" HeightRequest="60" CornerRadius="30" Padding="0"
                FontSize="30" BackgroundColor="#087A30" TextColor="White"
                SemanticProperties.Description="Open quick shortcuts" />
    </Grid>
</ContentPage>
