<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CCT_USCF.Pages.AnnouncementActivityPage"
             Title="Announcement" BackgroundColor="#F8FAFC">
    <CollectionView x:Name="NotificationsView" EmptyView="No church announcements yet.">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="14" Margin="10,6" BackgroundColor="White" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" />
                        <Label Text="{Binding Message}" />
                        <Label Text="{Binding SenderName}" FontSize="12" TextColor="#64748B" />
                        <Label Text="{Binding CreatedAtUtc, StringFormat='{0:g}'}" FontSize="12" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
