<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CCT_USCF.Pages.GroupChatPage"
    Title="Group Chat"
    BackgroundColor="{AppThemeBinding Light={StaticResource ChatBackground}, Dark={StaticResource UscfBackgroundDark}}">

    <ContentPage.Resources>
        <Style x:Key="ChatActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="MinimumWidthRequest" Value="40" />
        </Style>
        <Style x:Key="ComposerIconButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandDeepGreen}, Dark={StaticResource White}}" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="0">

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource ChatHeader}, Dark={StaticResource UscfSurfaceDark}}"
            Padding="18,14,18,16"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border
                    WidthRequest="46"
                    HeightRequest="46"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ChatAccent}, Dark={StaticResource AccentGold}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 23"
                    VerticalOptions="Center">
                    <Label
                        Text="✦"
                        FontSize="23"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label
                        x:Name="GroupTitleLabel"
                        Text="Group Chat"
                        FontSize="20"
                        FontAttributes="Bold"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        TextColor="White" />
                    <Label
                        x:Name="GroupStatusLabel"
                        Text="Loading group..."
                        FontSize="12"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        TextColor="{StaticResource ChatHeaderMuted}" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="2"
                    Text="⋮"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    Padding="0"
                    WidthRequest="42"
                    HeightRequest="42"
                    Clicked="OnGroupMenuClicked"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- MEMBERS -->
        <Grid
            Grid.Row="1"
            Margin="16,12,16,4"
            ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="8"
            VerticalOptions="Center">

            <Border
                Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource ChatSurface}, Dark={StaticResource UscfSurfaceDark}}"
                Padding="12,9"
                Stroke="{StaticResource ChatBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">
                <Label
                    x:Name="MembersLabel"
                    Text="Members"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource ChatMuted}, Dark={StaticResource Gray300}}" />
            </Border>

            <Button
                x:Name="AddMemberButton"
                Grid.Column="1"
                Text="Add member"
                Style="{StaticResource ChatActionButton}"
                BackgroundColor="{StaticResource BrandDeepGreen}"
                TextColor="White"
                VerticalOptions="Center" />

            <Button
                x:Name="MessageSelectionMenuButton"
                Grid.Column="2"
                Text="⋮"
                IsVisible="False"
                Style="{StaticResource ChatActionButton}"
                BackgroundColor="{StaticResource BrandDeepGreen}"
                TextColor="White"
                VerticalOptions="Center"
                Clicked="OnMessageSelectionMenuClicked" />

            <Button
                x:Name="DeleteGroupButton"
                Grid.Column="3"
                Text="Delete"
                IsVisible="False"
                Style="{StaticResource ChatActionButton}"
                BackgroundColor="{AppThemeBinding Light={StaticResource AccentGoldTint}, Dark={StaticResource Gray700}}"
                TextColor="#B91C1C"
                BorderColor="#FECACA"
                BorderWidth="1"
                VerticalOptions="Center"
                Clicked="OnDeleteGroupClicked" />

        </Grid>

        <!-- MESSAGES -->
        <RefreshView
            x:Name="MessagesRefreshView"
            Grid.Row="2"
            Refreshing="OnMessagesRefreshing">

            <ScrollView
                x:Name="MessagesScrollView"
                Scrolled="OnMessagesScrolled"
                Padding="16,8,16,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource ChatBackground}, Dark={StaticResource UscfBackgroundDark}}">

                <VerticalStackLayout
                    x:Name="MessagesLayout"
                    Spacing="2" />

            </ScrollView>
        </RefreshView>

        <Button
            x:Name="NewMessagesButton"
            Grid.Row="2"
            Text="New messages"
            IsVisible="False"
            Clicked="OnNewMessagesClicked"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,0,18"
            Padding="18,9"
            FontSize="12"
            FontAttributes="Bold"
            BackgroundColor="{StaticResource BrandDeepGreen}"
            TextColor="White"
            CornerRadius="18" />

        <!-- COMPOSER -->
        <Border
            Grid.Row="3"
            BackgroundColor="{AppThemeBinding Light={StaticResource ChatSurface}, Dark={StaticResource UscfSurfaceDark}}"
            Padding="14,10,14,14"
            Stroke="{StaticResource ChatBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18,18,0,0">

            <VerticalStackLayout
                Spacing="9">

                <Border
                    x:Name="ReplyPreviewLayout"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentGoldTint}, Dark={StaticResource Gray700}}"
                    Padding="12,8"
                    Stroke="{StaticResource ChatAccent}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <BoxView WidthRequest="3" CornerRadius="2" Color="{StaticResource ChatAccent}" />
                        <Label
                            Grid.Column="1"
                            x:Name="ReplyPreviewLabel"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource ChatText}, Dark={StaticResource White}}"
                            LineBreakMode="TailTruncation"
                            MaxLines="2" />
                        <Button
                            Grid.Column="2"
                            Text="✕"
                            WidthRequest="32"
                            HeightRequest="32"
                            Padding="0"
                            FontSize="14"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource ChatMuted}"
                            Clicked="OnCancelReplyClicked" />
                    </Grid>
                </Border>

                <!-- PENDING ATTACHMENT PREVIEW -->
                <Border
                    x:Name="AttachmentPreviewContainer"
                    IsVisible="False"
                    BackgroundColor="{StaticResource ChatInput}"
                    Padding="8"
                    Stroke="{StaticResource ChatBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Image
                            x:Name="AttachmentPreviewImage"
                            Grid.Column="0"
                            WidthRequest="70"
                            HeightRequest="70"
                            Aspect="AspectFill"
                            IsVisible="False" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center">
                            <Label
                                x:Name="AttachmentPreviewNameLabel"
                                Text="Attachment"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{StaticResource ChatText}" />
                            <Label
                                x:Name="AttachmentPreviewTypeLabel"
                                Text=""
                                FontSize="11"
                                TextColor="{StaticResource ChatMuted}" />
                        </VerticalStackLayout>

                        <Button
                            x:Name="RemoveAttachmentButton"
                            Grid.Column="2"
                            Text="✕"
                            FontSize="16"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="#B91C1C"
                            Clicked="OnRemoveAttachmentClicked" />
                    </Grid>
                </Border>

                <!-- MESSAGE INPUT -->
                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="8"
                    VerticalOptions="Center">

                    <Button
                        x:Name="AttachmentButton"
                        Grid.Column="0"
                        Text="📎"
                        Style="{StaticResource ComposerIconButton}"
                        Clicked="OnAttachmentClicked"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{StaticResource ChatInput}"
                        Stroke="{StaticResource ChatBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,0"
                        MinimumHeightRequest="46">
                        <Editor
                            x:Name="MessageEntry"
                            Placeholder="Share something with the group..."
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource ChatText}, Dark={StaticResource White}}"
                            PlaceholderColor="{StaticResource ChatMuted}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="46"
                            MaximumHeightRequest="120" />
                    </Border>

                    <Button
                        x:Name="SendButton"
                        Grid.Column="2"
                        Text="↑"
                        Clicked="OnSendClicked"
                        WidthRequest="46"
                        HeightRequest="46"
                        Padding="0"
                        FontSize="23"
                        FontAttributes="Bold"
                        CornerRadius="23"
                        BackgroundColor="{StaticResource BrandDeepGreen}"
                        TextColor="White"
                        VerticalOptions="Center" />

                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>